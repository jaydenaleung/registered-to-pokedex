{"id":472,"flavor":[{"games":["Legends: Arceus"],"text":"It glides soundlessly on pitch-black wings and sinks sharp fangs into the throat of its prey. It takes on a look of satisfaction once it has entirely drained its prey of blood."},{"games":["Alpha Sapphire","Y","SoulSilver","HeartGold"],"text":"Its flight is soundless. It uses its lengthy tail to carry off its prey... Then its elongated fangs do the rest."},{"games":["Omega Ruby","X","Pearl","Diamond"],"text":"It observes prey while hanging inverted from branches. When the chance presents itself, it swoops!"},{"games":["White 2","Black 2"],"text":"It dances silently through the sky. When it approaches prey, it can land a critical hit in an instant."},{"games":["White","Black","Platinum"],"text":"If it succeeds in catching even a faint breeze properly, it can circle the globe without flapping once."}],"abilities":[{"name":"Hyper Cutter","hidden":false,"description":"The Pokémon's prized, mighty pincers prevent other Pokémon from lowering its Attack stat."},{"name":"Sand Veil","hidden":false,"description":"Boosts the Pokémon's evasiveness in a sandstorm."},{"name":"Poison Heal","hidden":true,"description":"If poisoned, the Pokémon has its HP restored instead of taking damage."}],"eggGroups":["Bug"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Purple","shape":"Wings","evolution":{"id":207,"name":"Gligar","condition":null,"children":[{"id":472,"name":"Gliscor","condition":"Level up, holding Razor Fang (Night)","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[1,28],[1,106],[1,398],[1,422],[1,423],[1,424],[13,98],[16,210],[19,282],[22,512],[27,400],[30,369],[35,103],[40,404],[45,152],[50,14]],"machine":[512,332,97,226,784,280,523,242,399,38,814,414,89,203,263,206,424,374,416,441,667,63,423,282,679,232,341,189,398,342,182,706,240,156,157,317,328,201,799,184,806,214,188,191,446,444,522,164,241,129,14,366,36,269,851,168,675,422,92,390,369,474,404],"e