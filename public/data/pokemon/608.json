{"id":608,"flavor":[{"games":["Shield"],"text":"It lurks in cities, pretending to be a lamp. Once it finds someone whose death is near, it will trail quietly after them."},{"games":["Sword"],"text":"This Pokémon appears just before someone passes away, so it’s feared as an emissary of death."},{"games":["Alpha Sapphire","Y","White"],"text":"It arrives near the moment of death and steals spirit from the body."},{"games":["Omega Ruby","X","White 2","Black 2"],"text":"The spirits it absorbs fuel its baleful fire. It hangs around hospitals waiting for people to pass on."},{"games":["Black"],"text":"This ominous Pokémon is feared. Through cities it wanders, searching for the spirits of the fallen."}],"abilities":[{"name":"Flash Fire","hidden":false,"description":"If hit by a Fire-type move, the Pokémon absorbs the flames and uses them to power up its own Fire-type moves."},{"name":"Flame Body","hidden":false,"description":"Contact with the Pokémon may burn the attacker."},{"name":"Infiltrator","hidden":true,"description":"The Pokémon's moves are unaffected by the target's barriers, substitutes, and the like."}],"eggGroups":["Amorphous"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Black","shape":"Arms","evolution":{"id":607,"name":"Litwick","condition":null,"children":[{"id":608,"name":"Lampent","condition":"Lv. 41","children":[{"id":609,"name":"Chandelure","condition":"Use Dusk Stone","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[1,52],[1,107],[1,123],[1,310],[12,109],[16,506],[20,261],[24,83],[28,101],[32,174],[36,247],[40,517],[46,286],[52,220],[58,315],[64,262]],"machine":[807,347,109,174,399,203,412,263,126,83,488,53,394,114,257,506,286,808,101,315,220,809,182,244,94,156,247,806,214,76,180,164,241,269,915,851,168,271,433,261],"egg":[151,499,114,471],"tutor":[]},"cards":[{"id":"rsv10pt5-102","name":"Lampent","set":"White Flare","date":"2025-07-18","rarity":"Illustration Rare","number":"102","