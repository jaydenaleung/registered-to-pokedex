{"id":488,"flavor":[{"games":["Legends: Arceus"],"text":"Cresselia is reminiscent of the crescent moon. It leaves a brilliant line of light in its wake as it flies across the night sky. I daresay it resembles the heavenly maiden who created the Milky Way."},{"games":["Alpha Sapphire","Y","SoulSilver","HeartGold"],"text":"Those who sleep holding Cresselia’s feather are assured of joyful dreams. It is said to represent the crescent moon."},{"games":["Omega Ruby","X","Pearl","Diamond"],"text":"Shiny particles are released from its wings like a veil. It is said to represent the crescent moon."},{"games":["White 2","Black 2","White","Black","Platinum"],"text":"On nights around the quarter moon, the aurora from its tail extends and undulates beautifully."}],"abilities":[{"name":"Levitate","hidden":false,"description":"By floating in the air, the Pokémon receives full immunity to all Ground-type moves."}],"eggGroups":["Undiscovered"],"genderRate":8,"hatchCounter":120,"baseHappiness":100,"growthRate":"slow","habitat":null,"color":"Yellow","shape":"Squiggle","evolution":{"id":488,"name":"Cresselia","condition":null,"children":[]},"moves":{"game":"Scarlet / Violet","level":[[1,93],[1,104],[6,54],[12,62],[18,60],[24,502],[30,163],[36,427],[42,236],[48,219],[54,94],[60,585],[66,248],[72,461],[72,849]],"machine":[34,347,451,109,605,203,412,797,263,248,416,447,356,270,63,58,196,113,189,408,182,60,244,94,678,473,240,115,156,184,247,285,214,76,500,164,241,129,851,87,86,85,271,433,428],"egg":[],"tutor":[]},"cards":[{"id":"sv6pt5-71","name":"Cresselia","set":"Shrouded Fable","date":"2024-08-02","rarity":"Illustration Rare","number":"71","artist":"satoma","img":"sv6pt5/71"},{"id":"me55-74","name":"Cresselia","set":"30th Celebration","date":"2026-09-16","rarity":"Common","number":"74","artist":"KEIICHIRO ITO","small":"https://images.scrydex.com/pokemon/me55-74/small","large":"https://images.scrydex.com/pokemon/me55-74/large"},{"id":"me55c-99","name":"Darkrai & Cresselia LEGEND","set":"