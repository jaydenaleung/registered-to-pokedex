{"id":531,"flavor":[{"games":["Shield"],"text":"This Pokémon has a kind heart. By touching with its feelers, Audino can gauge other creatures’ feelings and physical conditions."},{"games":["Sword"],"text":"Audino’s sense of hearing is superb. Not even a pebble rolling along over a mile away will escape Audino’s ears."},{"games":["Alpha Sapphire","Y","Black"],"text":"It touches others with the feelers on its ears, using the sound of their heartbeats to tell how they are feeling."},{"games":["Omega Ruby","X","White 2","Black 2"],"text":"Using the feelers on its ears, it can tell how someone is feeling or when an egg might hatch."},{"games":["White"],"text":"Its auditory sense is astounding. It has a radarlike ability to understand its surroundings through slight sounds."}],"abilities":[{"name":"Healer","hidden":false,"description":"Sometimes cures the status conditions of the Pokémon's allies."},{"name":"Regenerator","hidden":false,"description":"The Pokémon has a little of its HP restored when withdrawn from battle."},{"name":"Klutz","hidden":true,"description":"The Pokémon can't use any held items."}],"eggGroups":["Fairy"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"fast","habitat":null,"color":"Pink","shape":"Upright","evolution":{"id":531,"name":"Audino","condition":null,"children":[]},"moves":{"game":"Sword / Shield","level":[[1,1],[1,589],[4,574],[9,608],[12,270],[16,45],[20,428],[24,791],[28,495],[32,36],[36,493],[40,304],[44,505],[48,38],[52,494],[56,581],[60,387]],"machine":[502,133,213,59,34,347,605,91,409,577,227,203,263,126,7,53,374,416,447,270,63,304,58,8,196,231,113,67,25,5,581,182,94,473,240,115,156,514,496,219,247,285,214,173,76,707,164,241,57,675,87,9,86,85,433,253,528,526,428],"egg":[361,186,273,281],"tutor":[]},"cards":[{"id":"zsv10pt5-151","name":"Audino","set":"Black Bolt","date":"2025-07-18","rarity":"Illustration Rare","number":"151","artist":"Asako Ito","img":"zsv10pt5/151"},{"id":"me2pt5-172","name":"Mega Audino ex","set"