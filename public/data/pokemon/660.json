{"id":660,"flavor":[{"games":["Shield"],"text":"The fur on its belly retains heat exceptionally well. People used to make heavy winter clothing from fur shed by this Pokémon."},{"games":["Sword"],"text":"With power equal to an excavator, it can dig through dense bedrock. It’s a huge help during tunnel construction."},{"games":["Alpha Sapphire","Y"],"text":"As powerful as an excavator, its ears can reduce dense bedrock to rubble. When it’s finished digging, it lounges lazily."},{"games":["Omega Ruby","X"],"text":"With their powerful ears, they can heft boulders of a ton or more with ease. They can be a big help at construction sites."}],"abilities":[{"name":"Pickup","hidden":false,"description":"The Pokémon may pick up an item another Pokémon used during a battle. It may pick up items outside of battle, too."},{"name":"Cheek Pouch","hidden":false,"description":"The Pokémon's HP is restored when it eats any Berry, in addition to the Berry's usual effect."},{"name":"Huge Power","hidden":true,"description":"Doubles the Pokémon's Attack stat."}],"eggGroups":["Field"],"genderRate":4,"hatchCounter":15,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Brown","shape":"Upright","evolution":{"id":659,"name":"Bunnelby","condition":null,"children":[{"id":660,"name":"Diggersby","condition":"Lv. 20","children":[]}]},"moves":{"game":"Sword / Shield","level":[[1,33],[1,43],[1,189],[1,673],[9,98],[12,341],[15,175],[18,24],[23,523],[28,91],[33,340],[38,36],[43,14],[48,89],[53,162],[58,359]],"machine":[97,213,34,340,280,693,339,523,91,414,89,203,263,7,374,492,416,447,441,667,63,8,442,231,67,25,5,341,371,182,156,157,317,496,328,201,214,188,173,191,707,444,164,276,57,14,168,9,369,253,528,526],"egg":[],"tutor":[815]},"cards":[{"id":"me3-65","name":"Diggersby","set":"Perfect Order","date":"2026-03-27","rarity":"Uncommon","number":"65","artist":null,"small":"https://images.scrydex.com/pokemon/me3-65/small","large":"https://images.scrydex.com/pokemon/me3-65/large"},{"id":"sv3-