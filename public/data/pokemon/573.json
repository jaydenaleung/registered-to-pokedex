{"id":573,"flavor":[{"games":["Shield"],"text":"A special oil that seeps through their fur helps them avoid attacks. The oil fetches a high price at market."},{"games":["Sword"],"text":"Its body secretes oil that this Pokémon spreads over its nest as a coating to protect it from dust. Cinccino won’t tolerate even a speck of the stuff."},{"games":["Ultra Moon"],"text":"The oil that seeps from its body is really smooth. For people troubled by bad skin, this oil is an effective treatment."},{"games":["Ultra Sun"],"text":"The white parts of its coat are covered in an oil secreted from its body, so this Pokémon can slide right away from its enemies’ attacks."},{"games":["Alpha Sapphire","Y","White 2","Black 2"],"text":"Cinccino’s body is coated in a special oil that helps it deflect attacks, such as punches."},{"games":["Omega Ruby","X","White"],"text":"Their white fur feels amazing to touch. Their fur repels dust and prevents static electricity from building up."},{"games":["Black"],"text":"Their white fur is coated in a special oil that makes it easy for them to deflect attacks."}],"abilities":[{"name":"Cute Charm","hidden":false,"description":"The Pokémon may infatuate attackers that make direct contact with it."},{"name":"Technician","hidden":false,"description":"Powers up weak moves so the Pokémon can deal more damage with them."},{"name":"Skill Link","hidden":true,"description":"Maximizes the number of times multistrike moves hit."}],"eggGroups":["Field"],"genderRate":6,"hatchCounter":15,"baseHappiness":70,"growthRate":"fast","habitat":null,"color":"Gray","shape":"Quadruped","evolution":{"id":572,"name":"Minccino","condition":null,"children":[{"id":573,"name":"Cinccino","condition":"Use Shiny Stone","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[0,541],[1,1],[1,47],[1,204],[1,331]],"machine":[914,226,331,347,204,886,605,91,38,227,283,203,263,313,374,411,416,447,441,270,63,304,861,282,113,189,583,182,240,156,350,402,214,164,241,162,129,36,851,168,87,8