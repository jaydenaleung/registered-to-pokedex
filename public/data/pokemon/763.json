{"id":763,"flavor":[{"games":["Shield"],"text":"A kick from the hardened tips of this Pokémon’s legs leaves a wound in the opponent’s body and soul that will never heal."},{"games":["Sword"],"text":"This feared Pokémon has long, slender legs and a cruel heart. It shows no mercy as it stomps on its opponents."},{"games":["Ultra Moon"],"text":"A Pokémon with an aggressive personality and a mastery of kicking, it cackles every time it kicks an opponent."},{"games":["Ultra Sun"],"text":"A master of grand and beautiful kicks, it can knock out even kickboxing champions with a single blow."},{"games":["Moon"],"text":"A Pokémon known for the beauty of its well-shaped legs, it sometimes appears as a mascot in advertisements for beauty salons."},{"games":["Sun"],"text":"Its long, striking legs aren’t just for show but to be used to kick with skill. In victory, it shows off by kicking the defeated, laughing boisterously."}],"abilities":[{"name":"Leaf Guard","hidden":false,"description":"Prevents status conditions in harsh sunlight."},{"name":"Queenly Majesty","hidden":false,"description":"When the Pokémon uses Surf or Dive, it will come back with prey. When it takes damage, it will spit out the prey to attack."},{"name":"Sweet Veil","hidden":true,"description":"Prevents the Pokémon and its allies from falling asleep."}],"eggGroups":["Grass"],"genderRate":8,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Purple","shape":"Humanoid","evolution":{"id":761,"name":"Bounsweet","condition":null,"children":[{"id":762,"name":"Steenee","condition":"Lv. 18","children":[{"id":763,"name":"Tsareena","condition":"Level up, knowing Stomp","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[0,688],[1,75],[1,150],[1,175],[1,207],[1,229],[1,438],[1,589],[16,230],[22,345],[28,23],[34,298],[40,597],[46,437],[58,136]],"machine":[512,331,204,605,577,283,203,412,263,374,202,416,447,803,580,270,63,282,437,113,67,490,345,572,583,182,115,156,402,214,76,