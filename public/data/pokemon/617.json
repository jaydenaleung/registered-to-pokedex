{"id":617,"flavor":[{"games":["Shield"],"text":"Discarding its shell made it nimble. To keep itself from dehydrating, it wraps its body in bands of membrane."},{"games":["Sword"],"text":"It moves with blinding speed and lobs poison at foes. Featuring Accelgor as a main character is a surefire way to make a movie or comic popular."},{"games":["Alpha Sapphire","Y","Black"],"text":"When its body dries out, it weakens. So, to prevent dehydration, it wraps itself in many layers of thin membrane."},{"games":["Omega Ruby","X","White"],"text":"Having removed its heavy shell, it becomes very light and can fight with ninja-like movements."},{"games":["White 2","Black 2"],"text":"When its body dries out, it weakens. So it wraps a membrane around itself for protection while it spits poison."}],"abilities":[{"name":"Hydration","hidden":false,"description":"Cures the Pokémon's status conditions in rain."},{"name":"Sticky Hold","hidden":false,"description":"The Pokémon's held items cling to its sticky body and cannot be removed by other Pokémon."},{"name":"Unburden","hidden":true,"description":"Boosts the Speed stat if the Pokémon's held item is used or lost."}],"eggGroups":["Bug"],"genderRate":4,"hatchCounter":15,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Red","shape":"Arms","evolution":{"id":616,"name":"Shelmet","condition":null,"children":[{"id":617,"name":"Accelgor","condition":"Trade, for Karrablast","children":[]}]},"moves":{"game":"Sword / Shield","level":[[1,34],[1,51],[1,71],[1,98],[1,104],[1,151],[1,174],[1,281],[1,385],[1,491],[1,594],[12,72],[16,522],[20,129],[24,97],[28,202],[32,384],[36,369],[40,105],[44,405],[48,515],[52,92]],"machine":[97,213,226,34,405,409,227,203,412,263,411,202,416,385,63,141,341,384,182,240,156,179,496,201,214,188,173,191,164,129,390,369,599,474],"egg":[],"tutor":[806]},"cards":[{"id":"rsv10pt5-94","name":"Accelgor","set":"White Flare","date":"2025-07-18","rarity":"Illustration Rare","number":"94","artist":"Taiga Kasai","i