{"id":760,"flavor":[{"games":["Shield"],"text":"The moves it uses to take down its prey would make a martial artist jealous. It tucks subdued prey under its arms to carry them to its nest."},{"games":["Sword"],"text":"Once it accepts you as a friend, it tries to show its affection with a hug. Letting it do that is dangerous—it could easily shatter your bones."},{"games":["Ultra Moon"],"text":"It boasts tremendous physical strength. Many people call it the most dangerous Pokémon in the Alola region."},{"games":["Ultra Sun"],"text":"It waves its hands wildly in intimidation and warning. Life is over for anyone who doesn’t run away as fast as possible."},{"games":["Moon"],"text":"This Pokémon has the habit of hugging its companions. Many Trainers have left this world after their spines were squashed by its hug."},{"games":["Sun"],"text":"This immensely dangerous Pokémon possesses overwhelming physical strength. Its habitat is generally off-limits."}],"abilities":[{"name":"Fluffy","hidden":false,"description":"Halves the damage taken from moves that make direct contact, but doubles that of Fire-type moves."},{"name":"Klutz","hidden":false,"description":"The Pokémon can't use any held items."},{"name":"Unnerve","hidden":true,"description":"Unnerves opposing Pokémon and makes them unable to eat Berries."}],"eggGroups":["Field"],"genderRate":4,"hatchCounter":15,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Pink","shape":"Upright","evolution":{"id":759,"name":"Stufful","condition":null,"children":[{"id":760,"name":"Bewear","condition":"Lv. 27","children":[]}]},"moves":{"game":"Sword / Shield","level":[[0,20],[1,33],[1,43],[1,371],[1,608],[12,693],[16,203],[20,70],[24,36],[30,175],[36,359],[42,37],[48,220],[54,38],[60,276]],"machine":[213,776,34,280,693,339,523,204,370,663,337,409,89,203,263,374,411,416,667,63,8,442,67,490,25,5,371,182,156,279,179,157,317,496,421,214,173,707,164,276,14,269,9,526,428],"egg":[],"tutor":[811]},"cards":[{"id":"sv6pt5-79","name