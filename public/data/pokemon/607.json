{"id":607,"flavor":[{"games":["Shield"],"text":"The younger the life this Pokémon absorbs, the brighter and eerier the flame on its head burns."},{"games":["Sword"],"text":"The flame on its head keeps its body slightly warm. This Pokémon takes lost children by the hand to guide them to the spirit world."},{"games":["Alpha Sapphire","Y","Black"],"text":"Litwick shines a light that absorbs the life energy of people and Pokémon, which becomes the fuel that it burns."},{"games":["Omega Ruby","X","White"],"text":"While shining a light and pretending to be a guide, it leeches off the life force of any who follow it."},{"games":["White 2","Black 2"],"text":"Its flame is usually out, but it starts shining when it absorbs life force from people or Pokémon."}],"abilities":[{"name":"Flash Fire","hidden":false,"description":"If hit by a Fire-type move, the Pokémon absorbs the flames and uses them to power up its own Fire-type moves."},{"name":"Flame Body","hidden":false,"description":"Contact with the Pokémon may burn the attacker."},{"name":"Infiltrator","hidden":true,"description":"The Pokémon's moves are unaffected by the target's barriers, substitutes, and the like."}],"eggGroups":["Amorphous"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"White","shape":"Blob","evolution":{"id":607,"name":"Litwick","condition":null,"children":[{"id":608,"name":"Lampent","condition":"Lv. 41","children":[{"id":609,"name":"Chandelure","condition":"Use Dusk Stone","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[1,123],[1,310],[4,52],[8,107],[12,109],[16,506],[20,261],[24,83],[28,101],[32,174],[36,247],[40,517],[44,286],[48,220],[52,315],[56,262]],"machine":[807,347,109,174,399,203,412,263,126,83,488,53,394,114,257,506,286,101,315,220,809,182,244,94,156,247,806,214,76,180,164,241,269,915,851,168,271,433,261],"egg":[151,499,114,471],"tutor":[]},"cards":[{"id":"rsv10pt5-101","name":"Litwick","set":"White Flare","date":"2025-