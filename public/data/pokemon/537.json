{"id":537,"flavor":[{"games":["Shield"],"text":"This Pokémon is popular among the elderly, who say the vibrations of its lumps are great for massages."},{"games":["Sword"],"text":"The vibrating of the bumps all over its body causes earthquake-like tremors. Seismitoad and Croagunk are similar species."},{"games":["Alpha Sapphire","Y","Black"],"text":"They shoot paralyzing liquid from their head bumps. They use vibration to hurt their opponents."},{"games":["Omega Ruby","X","White"],"text":"It increases the power of its punches by vibrating the bumps on its fists. It can turn a boulder to rubble with one punch."},{"games":["White 2","Black 2"],"text":"By putting power into its bumps, it creates vibrations and increases the power of its punches."}],"abilities":[{"name":"Swift Swim","hidden":false,"description":"Boosts the Pokémon's Speed stat in rain."},{"name":"Poison Touch","hidden":false,"description":"May poison a target when the Pokémon makes contact."},{"name":"Water Absorb","hidden":true,"description":"If hit by a Water-type move, the Pokémon has its HP restored instead of taking damage."}],"eggGroups":["Water 1"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Blue","shape":"Humanoid","evolution":{"id":535,"name":"Tympole","condition":null,"children":[{"id":536,"name":"Palpitoad","condition":"Lv. 25","children":[{"id":537,"name":"Seismitoad","condition":"Lv. 36","children":[]}]}]},"moves":{"game":"Sword / Shield","level":[[0,409],[1,45],[1,48],[1,51],[1,380],[1,497],[12,341],[16,496],[20,61],[24,175],[30,253],[39,392],[46,304],[54,330],[62,240],[70,56]],"machine":[213,340,280,523,91,291,409,414,89,203,263,374,411,416,447,258,56,63,304,8,196,710,67,25,5,341,330,371,398,438,182,240,156,157,317,496,503,103,214,188,482,173,446,707,164,57,253,599,474,311],"egg":[],"tutor":[]},"cards":[{"id":"zsv10pt5-105","name":"Seismitoad","set":"Black Bolt","date":"2025-07-18","rarity":"Illustration Rare","number":"105","arti