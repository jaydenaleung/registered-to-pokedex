{"id":460,"flavor":[{"games":["Legends: Arceus"],"text":"A powerful Pokémon that can split huge boulders with ease. Dislikes associating with others and chooses to live quietly deep within the mountains, playing with the snow."},{"games":["Shield"],"text":"This Pokémon is known to bring blizzards. A shake of its massive body is enough to cause whiteout conditions."},{"games":["Sword"],"text":"If it sees any packs of Darumaka going after Snover, it chases them off, swinging its sizable arms like hammers."},{"games":["Alpha Sapphire","Y","SoulSilver","HeartGold"],"text":"It lives a quiet life on mountains that are perpetually covered in snow. It hides itself by whipping up blizzards."},{"games":["Omega Ruby","X","Pearl"],"text":"It blankets wide areas in snow by whipping up blizzards. It is also known as “The Ice Monster.”"},{"games":["White 2","Black 2","White","Black","Platinum"],"text":"They appear when the snow flowers bloom. When the petals fall, they retreat to places unknown again."},{"games":["Diamond"],"text":"It whips up blizzards in mountains that are always buried in snow. It is the abominable snowman."}],"abilities":[{"name":"Snow Warning","hidden":false,"description":"The Pokémon makes it snow when it enters a battle."},{"name":"Soundproof","hidden":true,"description":"Soundproofing gives the Pokémon full immunity to all sound-based moves."}],"eggGroups":["Monster","Grass"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"slow","habitat":null,"color":"White","shape":"Upright","evolution":{"id":459,"name":"Snover","condition":null,"children":[{"id":460,"name":"Abomasnow","condition":"Lv. 40","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[0,8],[1,43],[1,54],[1,181],[1,670],[1,694],[15,420],[20,75],[25,196],[30,207],[35,275],[43,452],[49,59],[56,329]],"machine":[419,59,776,34,280,523,331,886,174,38,414,89,203,412,263,374,411,264,202,416,447,803,912,270,63,58,8,861,333,196,437,67,345,189,200,182,240,156,157,317,184,402,214,883