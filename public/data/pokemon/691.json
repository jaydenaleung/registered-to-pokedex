{"id":691,"flavor":[{"games":["Shield"],"text":"Dragalge generates dragon energy by sticking the plume on its head out above the ocean’s surface and bathing it in sunlight."},{"games":["Sword"],"text":"Dragalge uses a poisonous liquid capable of corroding metal to send tankers that enter its territory to the bottom of the sea."},{"games":["Ultra Moon"],"text":"It blends in with seaweed to ambush its prey and then takes them down with a poisonous liquid strong enough to melt metal."},{"games":["Ultra Sun"],"text":"This vicious Pokémon sprays a poisonous liquid on opponents that come near. For whatever reason, it gets along really well with Dhelmise."},{"games":["Alpha Sapphire","Y"],"text":"Tales are told of ships that wander into seas where Dragalge live, never to return."},{"games":["Omega Ruby","X"],"text":"Their poison is strong enough to eat through the hull of a tanker, and they spit it indiscriminately at anything that enters their territory."}],"abilities":[{"name":"Poison Point","hidden":false,"description":"Contact with the Pokémon may poison the attacker."},{"name":"Poison Touch","hidden":false,"description":"May poison a target when the Pokémon makes contact."},{"name":"Adaptability","hidden":true,"description":"Powers up moves of the same type as the Pokémon."}],"eggGroups":["Water 1","Dragon"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Brown","shape":"Blob","evolution":{"id":690,"name":"Skrelp","condition":null,"children":[{"id":691,"name":"Dragalge","condition":"Lv. 48","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[1,33],[1,51],[1,55],[1,108],[15,39],[20,104],[25,342],[30,352],[35,92],[40,406],[45,401],[52,188],[59,56],[66,200]],"machine":[491,886,434,406,203,263,812,411,416,441,114,56,63,196,710,341,189,330,200,583,342,182,240,156,503,799,184,247,214,188,482,883,180,164,57,36,851,168,87,85,92,390,474,352,127,250],"egg":[],"tutor":[]},"cards":[{"id":"me4-118","name":"Mega Dragalge e