{"id":768,"flavor":[{"games":["Shield"],"text":"They live in sunken ships or in holes in the seabed. When Golisopod and Grapploct battle, the loser becomes the winner’s meal."},{"games":["Sword"],"text":"It will do anything to win, taking advantage of every opening and finishing opponents off with the small claws on its front legs."},{"games":["Ultra Moon"],"text":"Its claws, which it can extend and retract at will, are its greatest weapons. Golisopod is sometimes accompanied by Wimpod."},{"games":["Ultra Sun"],"text":"The shell covering its body is as hard as diamond. This Pokémon will do anything it takes to win."},{"games":["Moon"],"text":"It battles skillfully with its six arms, but spends most of its time peacefully meditating in caves deep beneath the sea."},{"games":["Sun"],"text":"With a flashing slash of its giant sharp claws, it cleaves seawater—or even air—right in two."}],"abilities":[{"name":"Emergency Exit","hidden":false,"description":"The Pokémon, sensing danger, switches out when its HP becomes half or less."}],"eggGroups":["Bug","Water 3"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Gray","shape":"Humanoid","evolution":{"id":767,"name":"Wimpod","condition":null,"children":[{"id":768,"name":"Golisopod","condition":"Lv. 30","children":[]}]},"moves":{"game":"Sword / Shield","level":[[0,660],[1,28],[1,111],[1,180],[1,522],[4,249],[8,210],[12,341],[16,450],[20,334],[24,389],[28,163],[32,534],[36,42],[40,14],[44,710]],"machine":[372,213,59,280,405,339,370,399,291,529,203,263,206,374,411,416,258,63,58,196,334,442,141,710,341,330,371,42,398,182,240,534,156,157,317,496,503,103,421,214,188,482,555,173,191,164,57,129,14,269,675,474,127,404],"egg":[],"tutor":[806]},"cards":[{"id":"sv4-246","name":"Golisopod ex","set":"Paradox Rift","date":"2023-11-03","rarity":"Special Illustration Rare","number":"246","artist":"Oku","img":"sv4/246"},{"id":"me4-26","name":"Golisopod","set":"Chaos Rising","date":"2026-05-22"