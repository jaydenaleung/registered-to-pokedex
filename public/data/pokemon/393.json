{"id":393,"flavor":[{"games":["Legends: Arceus"],"text":"Prefers cold climes and appears along coasts. It's an adorable little thing—as cute as any child—but it's also prideful, unwilling to accept handouts from people."},{"games":["Alpha Sapphire","Y","Diamond"],"text":"Because it is very proud, it hates accepting food from people. Its thick down guards it from cold."},{"games":["Omega Ruby","X","SoulSilver","HeartGold"],"text":"It doesn’t like to be taken care of. It’s difficult to bond with since it won’t listen to its Trainer."},{"games":["White 2","Black 2","White","Black","Platinum"],"text":"A poor walker, it often falls down. However, its strong pride makes it puff up its chest without a care."},{"games":["Pearl"],"text":"It lives along shores in northern countries. A skilled swimmer, it dives for over 10 minutes to hunt."}],"abilities":[{"name":"Torrent","hidden":false,"description":"Powers up Water-type moves when the Pokémon's HP is low."},{"name":"Competitive","hidden":true,"description":"Boosts the Pokémon's Sp. Atk stat sharply when its stats are lowered by an opposing Pokémon."}],"eggGroups":["Water 1","Field"],"genderRate":1,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Blue","shape":"Humanoid","evolution":{"id":393,"name":"Piplup","condition":null,"children":[{"id":394,"name":"Prinplup","condition":"Lv. 16","children":[{"id":395,"name":"Empoleon","condition":"Lv. 36","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[1,1],[4,45],[8,55],[11,204],[15,64],[18,61],[22,207],[25,31],[29,362],[32,250],[36,54],[39,65],[43,56]],"machine":[332,97,59,280,204,886,574,203,263,297,374,812,447,114,270,56,58,861,196,710,182,244,240,156,317,214,883,164,57,129,851,813,518,352,127,311,250],"egg":[392,297,681,355,173,48,281],"tutor":[]},"cards":[{"id":"me2-98","name":"Piplup","set":"Phantasmal Flames","date":"2025-11-14","rarity":"Illustration Rare","number":"98","artist":"Jiro Sasumo","img":"me2/98"},{"id":"me2-27"