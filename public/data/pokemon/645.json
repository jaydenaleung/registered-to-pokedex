{"id":645,"flavor":[{"games":["Legends: Arceus"],"text":"When the incarnations of wind and of lightning clash, Landorus arrives to quell the conflict. After the tempests and thunderbolts abate, the land is sure to be blessed with bountiful harvests."},{"games":["Alpha Sapphire","Y","White 2","Black 2"],"text":"From the forces of lightning and wind, it creates energy to give nutrients to the soil and make the land abundant."},{"games":["Omega Ruby","X","Black"],"text":"Lands visited by Landorus grant such bountiful crops that it has been hailed as “The Guardian of the Fields.”"},{"games":["White"],"text":"The energy that comes pouring from its tail increases the nutrition in the soil, making crops grow to great size."}],"abilities":[{"name":"Sand Force","hidden":false,"description":"Boosts the power of Rock-, Ground-, and Steel-type moves in a sandstorm."},{"name":"Sheer Force","hidden":true,"description":"Removes any additional effects from the Pokémon's moves, but increases the moves' power."}],"eggGroups":["Undiscovered"],"genderRate":0,"hatchCounter":120,"baseHappiness":90,"growthRate":"slow","habitat":null,"color":"Brown","shape":"Arms","evolution":{"id":645,"name":"Landorus","condition":null,"children":[]},"moves":{"game":"Scarlet / Violet","level":[[1,328],[1,479],[5,43],[10,335],[15,523],[20,317],[30,286],[35,157],[40,414],[45,326],[50,444],[55,359],[60,201],[65,89],[70,200],[75,90],[80,848]],"machine":[34,280,339,523,347,242,91,414,89,203,263,374,19,411,416,447,356,63,286,341,189,417,200,182,94,240,156,157,317,328,201,184,815,214,188,482,479,446,707,444,164,241,14,36,269,851,369,311],"egg":[],"tutor":[]},"cards":[{"id":"zsv10pt5-131","name":"Landorus","set":"Black Bolt","date":"2025-07-18","rarity":"Illustration Rare","number":"131","artist":"SIE NANAHARA","img":"zsv10pt5/131"},{"id":"me3-41","name":"Landorus","set":"Perfect Order","date":"2026-03-27","rarity":"Rare","number":"41","artist":null,"small":"https://images.scrydex.com/pokemon/me3-41/small","large