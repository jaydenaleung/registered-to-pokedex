{"id":395,"flavor":[{"games":["Legends: Arceus"],"text":"Since ancient times, it has been revered by the people of Hisui, who call it the Master of the Waves. Its wings are a match for even master-crafted blades."},{"games":["Alpha Sapphire","Y","Diamond"],"text":"The three horns that extend from its beak attest to its power. The leader has the biggest horns."},{"games":["Omega Ruby","X","Pearl"],"text":"It swims as fast as a jet boat. The edges of its wings are sharp and can slice apart drifting ice."},{"games":["White 2","Black 2","White","Black","Platinum"],"text":"If anyone were to hurt its pride, it would slash them with wings that can cleave through an ice floe."},{"games":["SoulSilver","HeartGold"],"text":"It avoids unnecessary disputes, but it will decimate anything that threatens its pride."}],"abilities":[{"name":"Torrent","hidden":false,"description":"Powers up Water-type moves when the Pokémon's HP is low."},{"name":"Competitive","hidden":true,"description":"Boosts the Pokémon's Sp. Atk stat sharply when its stats are lowered by an opposing Pokémon."}],"eggGroups":["Water 1","Field"],"genderRate":1,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Blue","shape":"Upright","evolution":{"id":393,"name":"Piplup","condition":null,"children":[{"id":394,"name":"Prinplup","condition":"Lv. 16","children":[{"id":395,"name":"Empoleon","condition":"Lv. 36","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[0,453],[1,33],[1,45],[1,55],[1,232],[11,14],[15,64],[19,61],[24,207],[28,31],[33,362],[39,250],[46,54],[52,65],[59,56],[66,834]],"machine":[332,97,314,403,419,59,34,280,523,204,886,574,38,814,89,203,263,206,297,430,374,812,416,447,114,270,308,56,63,58,861,196,334,282,808,710,232,319,189,182,244,240,156,46,157,317,184,421,214,883,446,796,164,57,129,14,36,851,675,813,253,410,518,352,127,311,250],"egg":[392,297,681,355,173,48,281],"tutor":[]},"cards":[{"id":"me2-70","name":"Empoleon ex","set":"Phantasmal Flames","dat