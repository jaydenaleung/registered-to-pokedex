{"id":416,"flavor":[{"games":["Legends: Arceus"],"text":"Commands its subjects to build its hive. It will dispatch any interlopers who dare sneak into its nest and use them as nourishment for itself."},{"games":["Shield"],"text":"Vespiquen that give off more pheromones have larger swarms of Combee attendants."},{"games":["Sword"],"text":"It skillfully commands its grubs in battles with its enemies. The grubs are willing to risk their lives to defend Vespiquen."},{"games":["Alpha Sapphire","Y","Diamond"],"text":"Its abdomen is a honeycomb for grubs. It raises its grubs on honey collected by Combee."},{"games":["Omega Ruby","X","White 2","Black 2"],"text":"It houses its colony in cells in its body and releases various pheromones to make those grubs do its bidding."},{"games":["White","Black","Platinum"],"text":"It releases various pheromones to make the grubs in its body do its bidding while fighting foes."},{"games":["SoulSilver","HeartGold"],"text":"It raises grubs in the holes in its body. It secretes pheromones to control COMBEE."},{"games":["Pearl"],"text":"When endangered, grubs from its six-cell honeycomb strike back. There is only one in a colony."}],"abilities":[{"name":"Pressure","hidden":false,"description":"Puts other Pokémon under pressure, causing them to expend more PP to use their moves."},{"name":"Unnerve","hidden":true,"description":"Unnerves opposing Pokémon and makes them unable to eat Berries."}],"eggGroups":["Bug"],"genderRate":8,"hatchCounter":15,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Yellow","shape":"Bug wings","evolution":{"id":415,"name":"Combee","condition":null,"children":[{"id":416,"name":"Vespiquen","condition":"Lv. 21 (female)","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[0,163],[1,16],[1,40],[1,109],[1,230],[1,450],[1,522],[4,210],[8,597],[12,565],[16,154],[20,207],[24,355],[28,403],[32,408],[36,92],[40,454],[40,455],[44,194]],"machine":[512,332,97,403,450,405,109,814,283,203,263,374,416,2