{"id":563,"flavor":[{"games":["Shield"],"text":"There are many depictions of Cofagrigus decorating ancient tombs. They’re symbols of the wealth that kings of bygone eras had."},{"games":["Sword"],"text":"This Pokémon has a body of sparkling gold. People say it no longer remembers that it was once human."},{"games":["Alpha Sapphire","Y","White 2","Black 2"],"text":"Grave robbers who mistake them for real coffins and get too close end up trapped inside their bodies."},{"games":["Omega Ruby","X","Black"],"text":"It has been said that they swallow those who get too close and turn them into mummies. They like to eat gold nuggets."},{"games":["White"],"text":"They pretend to be elaborate coffins to teach lessons to grave robbers. Their bodies are covered in pure gold."}],"abilities":[{"name":"Mummy","hidden":false,"description":"Contact with the Pokémon changes the attacker’s Ability to Mummy."}],"eggGroups":["Mineral","Amorphous"],"genderRate":4,"hatchCounter":25,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Yellow","shape":"Blob","evolution":{"id":562,"name":"Yamask","condition":null,"children":[{"id":563,"name":"Cofagrigus","condition":"Lv. 34","children":[]},{"id":867,"name":"Runerigus","condition":"Take 49+ damage, then pass under a stone arch at Dusty Bowl","children":[]}]},"moves":{"game":"Sword / Shield","level":[[0,421],[1,101],[1,114],[1,182],[1,184],[1,310],[12,50],[16,261],[20,578],[24,506],[28,212],[32,288],[38,174],[44,247],[50,399],[56,470],[56,471],[62,194]],"machine":[502,213,776,347,399,203,412,263,313,416,447,385,506,63,286,334,417,371,566,384,182,94,240,156,279,496,219,184,247,421,285,214,173,164,168,390,271,433,261,472,428],"egg":[],"tutor":[809]},"cards":[{"id":"rsv10pt5-123","name":"Cofagrigus","set":"White Flare","date":"2025-07-18","rarity":"Illustration Rare","number":"123","artist":"Haru Akasaka","img":"rsv10pt5/123"},{"id":"rsv10pt5-40","name":"Cofagrigus","set":"White Flare","date":"2025-07-18","rarity":"Rare","number":"40",