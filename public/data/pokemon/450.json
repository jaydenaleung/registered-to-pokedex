{"id":450,"flavor":[{"games":["Legends: Arceus"],"text":"Short-tempered and easily moved to violence. It whips up whirlwinds of sand to crush its foes' spirits, then goes in for the attack."},{"games":["Shield"],"text":"When roused to violence by its rage, it spews out the quantities of sand it has swallowed and whips up a sandstorm."},{"games":["Sword"],"text":"Stones can get stuck in the ports on their bodies. Dwebble help dislodge such stones, so Hippowdon look after these Pokémon."},{"games":["Alpha Sapphire","Y","Diamond"],"text":"It blasts internally stored sand from ports on its body to create a towering twister for attack."},{"games":["Omega Ruby","X","SoulSilver","HeartGold"],"text":"It brandishes its gaping mouth in a display of fearsome strength. It raises vast quantities of sand while attacking."},{"games":["White 2","Black 2","White","Black","Platinum"],"text":"It is surprisingly quick to anger. It holds its mouth agape as a display of its strength."},{"games":["Pearl"],"text":"Its huge mouth is almost seven feet across. It has enough power to completely crush a car."}],"abilities":[{"name":"Sand Stream","hidden":false,"description":"The Pokémon summons a sandstorm when it enters a battle."},{"name":"Sand Force","hidden":true,"description":"Boosts the power of Rock-, Ground-, and Steel-type moves in a sandstorm."}],"eggGroups":["Field"],"genderRate":4,"hatchCounter":30,"baseHappiness":70,"growthRate":"slow","habitat":null,"color":"Brown","shape":"Quadruped","evolution":{"id":449,"name":"Hippopotas","condition":null,"children":[{"id":450,"name":"Hippowdon","condition":"Lv. 34","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[1,28],[1,33],[1,44],[1,281],[1,422],[1,423],[1,424],[12,328],[16,91],[20,242],[24,201],[28,36],[32,46],[38,156],[44,89],[50,38],[56,90],[62,303]],"machine":[133,776,34,523,242,174,91,38,414,89,203,263,424,416,912,484,270,667,63,304,423,442,341,189,330,182,156,46,157,317,328,201,815,214,446,707,444,164,241,36,851,422],"eg