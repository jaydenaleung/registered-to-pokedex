{"id":455,"flavor":[{"games":["Legends: Arceus"],"text":"Though this is a plant Pokémon, it has a gluttonous and unruly temperament. Carnivine attacks its prey with its cavernous maw wide open."},{"games":["Alpha Sapphire","Y","White","Black","Platinum"],"text":"It binds itself to trees in marshes. It attracts prey with its sweet-smelling drool and gulps them down."},{"games":["Omega Ruby","X","Diamond"],"text":"It attracts prey with its sweet-smelling saliva, then chomps down. It takes a whole day to eat prey."},{"games":["White 2","Black 2"],"text":"Using its tentacles to lash itself to trees, it lies in wait for prey, luring it close with sweet-smelling drool."},{"games":["SoulSilver","HeartGold"],"text":"It walks around on its tentacles in search of a tree branch where it can dangle down and ambush prey."},{"games":["Pearl"],"text":"Hanging from branches using its tentacles, it looks like a plant. It awaits prey, mouth wide open."}],"abilities":[{"name":"Levitate","hidden":false,"description":"By floating in the air, the Pokémon receives full immunity to all Ground-type moves."}],"eggGroups":["Grass"],"genderRate":4,"hatchCounter":25,"baseHappiness":70,"growthRate":"slow","habitat":null,"color":"Green","shape":"Tentacles","evolution":{"id":455,"name":"Carnivine","condition":null,"children":[]},"moves":{"game":"Ultra Sun / Ultra Moon","level":[[1,20],[1,74],[7,44],[11,22],[17,230],[21,275],[27,185],[31,536],[37,254],[37,255],[37,256],[41,242],[47,378],[50,438]],"machine":[213,590,104,412,263,374,218,416,447,237,63,611,267,371,182,156,216,496,214,188,76,164,241,207,14,168,92],"egg":[491,202,320,73,345,476,75,21,79,78,235,388],"tutor":[20,450,432,380,202,282,402,173,235,675,388]},"cards":[{"id":"me4-4","name":"Carnivine","set":"Chaos Rising","date":"2026-05-22","rarity":"Common","number":"4","artist":"Heisuke Kitazawa","small":"https://images.scrydex.com/pokemon/me4-4/small","large":"https://images.scrydex.com/pokemon/me4-4/large"},{"id":"sv7-7","name":"Carnivine",