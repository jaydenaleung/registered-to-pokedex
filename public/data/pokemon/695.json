{"id":695,"flavor":[{"games":["Shield"],"text":"One Heliolisk basking in the sun with its frill outspread is all it would take to produce enough electricity to power a city."},{"games":["Sword"],"text":"A now-vanished desert culture treasured these Pokémon. Appropriately, when Heliolisk came to the Galar region, treasure came with them."},{"games":["Alpha Sapphire","Y"],"text":"It stimulates its muscles with electricity, boosting the strength in its legs and enabling it to run 100 yards in five seconds."},{"games":["Omega Ruby","X"],"text":"They flare their frills and generate energy. A single Heliolisk can generate sufficient electricity to power a skyscraper."}],"abilities":[{"name":"Dry Skin","hidden":false,"description":"Restores the Pokémon's HP in rain or when it is hit by Water-type moves. Reduces HP in harsh sunlight, and increases the damage received from Fire-type moves."},{"name":"Sand Veil","hidden":false,"description":"Boosts the Pokémon's evasiveness in a sandstorm."},{"name":"Solar Power","hidden":true,"description":"In harsh sunlight, the Pokémon's Sp. Atk stat is boosted, but its HP decreases every turn."}],"eggGroups":["Monster","Dragon"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Yellow","shape":"Upright","evolution":{"id":694,"name":"Helioptile","condition":null,"children":[{"id":695,"name":"Heliolisk","condition":"Use Sun Stone","children":[]}]},"moves":{"game":"Sword / Shield","level":[[1,1],[1,39],[1,84],[1,85],[1,86],[1,87],[1,98],[1,189],[1,268],[1,435],[1,521],[1,523],[1,570],[1,582],[1,598]],"machine":[97,502,213,784,693,523,399,91,406,598,604,486,527,203,263,7,411,416,447,63,304,231,113,67,490,25,5,182,240,156,157,317,496,201,214,173,76,164,241,57,129,87,9,86,85,369,521,311,528],"egg":[],"tutor":[804,799]},"cards":[{"id":"me2pt5-229","name":"Heliolisk","set":"Ascended Heroes","date":"2026-01-30","rarity":"Illustration Rare","number":"229","artist":"Takeshi Nakamura","small":"https://i