{"id":391,"flavor":[{"games":["Legends: Arceus"],"text":"The deeper the blue on its face, the more powerful it will grow to become. It leaps about every which way and lands powerful blows against its opponents with the flame on its tail."},{"games":["Alpha Sapphire","Y","Pearl"],"text":"It uses ceilings and walls to launch aerial attacks. Its fiery tail is but one weapon."},{"games":["Omega Ruby","X","White 2","Black 2","White","Black","Platinum"],"text":"It skillfully controls the intensity of the fire on its tail to keep its foes at an ideal distance."},{"games":["SoulSilver","HeartGold"],"text":"A bigger fire on its tail and a brighter blue pattern on its face means its rank in its pack is higher."},{"games":["Diamond"],"text":"To intimidate attackers, it stretches the fire on its tail to make itself appear bigger."}],"abilities":[{"name":"Blaze","hidden":false,"description":"Powers up Fire-type moves when the Pokémon's HP is low."},{"name":"Iron Fist","hidden":true,"description":"Powers up punching moves."}],"eggGroups":["Field","Human-Like"],"genderRate":1,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Brown","shape":"Upright","evolution":{"id":390,"name":"Chimchar","condition":null,"children":[{"id":391,"name":"Monferno","condition":"Lv. 14","children":[{"id":392,"name":"Infernape","condition":"Lv. 36","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[0,183],[1,10],[1,43],[1,52],[9,269],[16,154],[19,172],[26,364],[29,259],[36,370],[39,83],[46,512],[49,303],[56,394]],"machine":[512,97,280,339,807,370,91,38,409,227,283,203,263,313,126,519,7,83,488,53,394,374,411,264,447,441,257,270,282,808,67,490,118,189,417,315,398,182,244,156,179,157,317,421,214,479,446,164,241,129,14,36,269,915,851,168,9,369,918,253,410,261,428],"egg":[68,24,227,252,7,116,257,270,415,9],"tutor":[]},"cards":[{"id":"sv6-32","name":"Monferno","set":"Twilight Masquerade","date":"2024-05-24","rarity":"Common","number":"32","artist":"Scav","img