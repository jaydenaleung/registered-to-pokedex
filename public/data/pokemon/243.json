{"id":243,"flavor":[{"games":["Alpha Sapphire","Omega Ruby","Sapphire","Ruby"],"text":"Raikou embodies the speed of lightning. The roars of this Pokémon send shock waves shuddering through the air and shake the ground as if lightning bolts had come crashing down."},{"games":["Y","Crystal"],"text":"This rough Pokémon stores energy inside its body, then sweeps across the land, shooting off electricity."},{"games":["X","HeartGold","LeafGreen","Gold"],"text":"The rain clouds it carries let it fire thunderbolts at will. They say that it descended with lightning."},{"games":["White 2","Black 2","White","Black","Platinum","Pearl","Diamond"],"text":"It is said to have fallen with lightning. It can fire thunderbolts from the rain clouds on its back."},{"games":["SoulSilver","Silver"],"text":"A Pokémon that races across the land while barking a cry that sounds like crashing thunder."},{"games":["FireRed"],"text":"This POKéMON races across the land while barking a cry that sounds like crashing thunder."},{"games":["Emerald"],"text":"RAIKOU embodies the speed of lightning. Its roars send shock waves shuddering through the air and ground as if lightning bolts were crashing down."}],"abilities":[{"name":"Pressure","hidden":false,"description":"Puts other Pokémon under pressure, causing them to expend more PP to use their moves."},{"name":"Inner Focus","hidden":true,"description":"The Pokémon's intense focus prevents it from flinching or being affected by Intimidate."}],"eggGroups":["Undiscovered"],"genderRate":-1,"hatchCounter":80,"baseHappiness":35,"growthRate":"slow","habitat":"grassland","color":"Yellow","shape":"Quadruped","evolution":{"id":243,"name":"Raikou","condition":null,"children":[]},"moves":{"game":"Scarlet / Violet","level":[[1,43],[1,84],[1,98],[1,245],[1,268],[6,209],[12,44],[18,347],[24,46],[30,422],[36,336],[42,242],[48,326],[54,435],[60,115],[66,240],[72,87],[78,192]],"machine":[97,396,34,347,268,451,242,38,598,604,486,527,203,263,416,270,63,442,113,189,182,240