{"id":715,"flavor":[{"games":["Shield"],"text":"Flying through the darkness, it weakens enemies with ultrasonic waves that could crush stone. Its fangs finish the fight."},{"games":["Sword"],"text":"Aggressive and cruel, this Pokémon will ruthlessly torment enemies that are helpless in the dark."},{"games":["Ultra Moon"],"text":"This hot-blooded Pokémon attacks anything it sees with ultrasonic waves that can crush boulders."},{"games":["Ultra Sun"],"text":"Although it has a violent disposition, if you give it a nice ripe fruit that it loves, Noivern will suddenly become tame."},{"games":["Alpha Sapphire","Y"],"text":"The ultrasonic waves it emits from its ears can reduce a large boulder to pebbles. It swoops out of the dark to attack."},{"games":["Omega Ruby","X"],"text":"They fly around on moonless nights and attack careless prey. Nothing can beat them in a battle in the dark."}],"abilities":[{"name":"Frisk","hidden":false,"description":"When it enters a battle, the Pokémon can check an opposing Pokémon's held item."},{"name":"Infiltrator","hidden":false,"description":"The Pokémon's moves are unaffected by the target's barriers, substitutes, and the like."},{"name":"Telepathy","hidden":true,"description":"The Pokémon anticipates and dodges the attacks of its allies."}],"eggGroups":["Flying","Dragon"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Purple","shape":"Wings","evolution":{"id":714,"name":"Noibat","condition":null,"children":[{"id":715,"name":"Noivern","condition":"Lv. 48","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[0,406],[1,16],[1,33],[1,48],[1,71],[1,236],[12,104],[16,17],[20,44],[24,314],[28,18],[32,162],[36,403],[40,103],[44,355],[51,366],[56,542],[62,586]],"machine":[512,332,97,314,403,34,784,280,399,38,434,913,337,349,406,525,814,203,263,53,19,411,416,257,542,63,304,141,200,182,94,917,156,184,247,421,214,76,164,241,162,129,366,36,269,851,168,369,253,352,528,404],"egg":[],"tutor":[