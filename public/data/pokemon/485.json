{"id":485,"flavor":[{"games":["Legends: Arceus"],"text":"Stories tell of this Pokémon being birthed from the boiling magma within Mount Coronet. Its molten-steel body holds many mysteries."},{"games":["Alpha Sapphire","Y","SoulSilver","HeartGold"],"text":"Boiling blood, like magma, circulates through its body. It makes its dwelling place in volcanic caves."},{"games":["Omega Ruby","X","Pearl","Diamond"],"text":"It dwells in volcanic caves. It digs in with its cross-shaped feet to crawl on ceilings and walls."},{"games":["White 2","Black 2","White","Black","Platinum"],"text":"Its body is made of rugged steel. However, it is partially melted in spots because of its own heat."}],"abilities":[{"name":"Flash Fire","hidden":false,"description":"If hit by a Fire-type move, the Pokémon absorbs the flames and uses them to power up its own Fire-type moves."},{"name":"Flame Body","hidden":true,"description":"Contact with the Pokémon may burn the attacker."}],"eggGroups":["Undiscovered"],"genderRate":4,"hatchCounter":10,"baseHappiness":100,"growthRate":"slow","habitat":null,"color":"Brown","shape":"Quadruped","evolution":{"id":485,"name":"Heatran","condition":null,"children":[]},"moves":{"game":"Scarlet / Violet","level":[[1,43],[1,83],[6,232],[12,246],[18,424],[24,184],[30,442],[36,242],[42,436],[48,319],[54,414],[60,257],[66,444],[72,463]],"machine":[776,34,523,807,242,399,91,406,414,89,203,263,126,424,83,488,53,394,430,416,912,535,257,484,63,334,442,679,232,319,315,884,408,182,156,350,157,317,201,184,815,214,76,446,796,707,444,164,241,36,269,851,261],"egg":[],"tutor":[]},"cards":[{"id":"me5-7","name":"Heatran","set":"Pitch Black","date":"2026-07-17","rarity":"Uncommon","number":"7","artist":"Takeshi Nakamura","small":"https://images.scrydex.com/pokemon/me5-7/small","large":"https://images.scrydex.com/pokemon/me5-7/large"},{"id":"sv8pt5-68","name":"Heatran","set":"Prismatic Evolutions","date":"2025-01-17","rarity":"Uncommon","number":"68","artist":null,"img":"sv8pt5/68"},{"id