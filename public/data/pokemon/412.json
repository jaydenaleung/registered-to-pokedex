{"id":412,"flavor":[{"games":["Legends: Arceus"],"text":"If its cloak is even slightly damaged, Burmy will immediately repair it with whatever is close at hand. The Pokémon within the cloak is scrawny and vulnerable to the cold."},{"games":["Alpha Sapphire","Y","Pearl"],"text":"If its cloak is broken in battle, it quickly remakes the cloak with materials nearby."},{"games":["Omega Ruby","X","Diamond"],"text":"To shelter itself from cold, wintry winds, it covers itself with a cloak made of twigs and leaves."},{"games":["White 2","Black 2","White","Black","Platinum"],"text":"Even if it is born where there are no cocooning materials, it somehow always ends up with a cloak."},{"games":["SoulSilver","HeartGold"],"text":"It covers itself with a cloak to shelter from the cold. When it’s hot, its cloak is thinner."}],"abilities":[{"name":"Shed Skin","hidden":false,"description":"The Pokémon may cure its own status conditions by shedding its skin."},{"name":"Overcoat","hidden":true,"description":"The Pokémon takes no damage from sandstorms. It is also protected from the effects of powders and spores."}],"eggGroups":["Bug"],"genderRate":4,"hatchCounter":15,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Green","shape":"Blob","evolution":{"id":412,"name":"Burmy","condition":null,"children":[{"id":413,"name":"Wormadam","condition":"Lv. 20 (female)","children":[]},{"id":414,"name":"Mothim","condition":"Lv. 20 (male)","children":[]}]},"moves":{"game":"Ultra Sun / Ultra Moon","level":[[1,182],[10,33],[15,450],[20,237]],"machine":[237,182],"egg":[],"tutor":[450,527,173]},"cards":[{"id":"swsh9-9","name":"Burmy","set":"Brilliant Stars","date":"2022-02-25","rarity":"Common","number":"9","artist":"Miki Tanaka","img":"swsh9/9"},{"id":"xy10-2","name":"Burmy","set":"Fates Collide","date":"2016-05-02","rarity":"Common","number":"2","artist":"Kouki Saitou","img":"xy10/2"},{"id":"pl4-56","name":"Burmy Plant Cloak","set":"Arceus","date":"2009-11-04","rarity":"Common","number"