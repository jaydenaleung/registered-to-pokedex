{"id":621,"flavor":[{"games":["Shield"],"text":"Druddigon are vicious and cunning. They take up residence in nests dug out by other Pokémon, treating the stolen nests as their own lairs."},{"games":["Sword"],"text":"Druddigon lives in caves, but it never skips sunbathing—it won’t be able to move if its body gets too cold."},{"games":["Ultra Moon"],"text":"It infiltrates tunnels that Pokémon like Diglett and Dugtrio have dug and quietly waits for prey to pass through."},{"games":["Ultra Sun"],"text":"The red skin on its face is harder than rock. In narrow caves, it squares off against its enemies and charges face-first right into them."},{"games":["Alpha Sapphire","Y","Black"],"text":"It warms its body by absorbing sunlight with its wings. When its body temperature falls, it can no longer move."},{"games":["Omega Ruby","X","White"],"text":"It races through narrow caves, using its sharp claws to catch prey. The skin on its face is harder than a rock."},{"games":["White 2","Black 2"],"text":"It runs through the narrow tunnels formed by Excadrill and Onix. It uses its sharp claws to catch prey."}],"abilities":[{"name":"Rough Skin","hidden":false,"description":"The Pokémon's rough skin damages attackers that make direct contact with it."},{"name":"Sheer Force","hidden":false,"description":"Removes any additional effects from the Pokémon's moves, but increases the moves' power."},{"name":"Mold Breaker","hidden":true,"description":"The Pokémon's moves are unimpeded by the Ability of the target."}],"eggGroups":["Dragon","Monster"],"genderRate":4,"hatchCounter":30,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Red","shape":"Upright","evolution":{"id":621,"name":"Druddigon","condition":null,"children":[]},"moves":{"game":"Sword / Shield","level":[[1,10],[1,43],[5,44],[10,525],[15,232],[20,184],[25,163],[30,337],[35,468],[40,242],[45,442],[50,200],[55,276]],"machine":[213,34,523,242,399,91,337,406,89,203,263,424,7,53,430,374,411,416,441,257,63,442,231,5,200,3