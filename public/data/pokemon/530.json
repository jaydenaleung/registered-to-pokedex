{"id":530,"flavor":[{"games":["Shield"],"text":"Known as the Drill King, this Pokémon can tunnel through the terrain at speeds of over 90 mph."},{"games":["Sword"],"text":"It’s not uncommon for tunnels that appear to have formed naturally to actually be a result of Excadrill’s rampant digging."},{"games":["Alpha Sapphire","Y","White"],"text":"More than 300 feet below the surface, they build mazelike nests. Their activity can be destructive to subway tunnels."},{"games":["Omega Ruby","X","Black"],"text":"It can help in tunnel construction. Its drill has evolved into steel strong enough to bore through iron plates."},{"games":["White 2","Black 2"],"text":"Forming a drill with its steel claws and head, it can bore through a steel plate, no matter how thick it is."}],"abilities":[{"name":"Sand Rush","hidden":false,"description":"Boosts the Pokémon's Speed stat in a sandstorm."},{"name":"Sand Force","hidden":false,"description":"Boosts the power of Rock-, Ground-, and Steel-type moves in a sandstorm."},{"name":"Mold Breaker","hidden":true,"description":"The Pokémon's moves are unimpeded by the Ability of the target."}],"eggGroups":["Field"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Gray","shape":"Humanoid","evolution":{"id":529,"name":"Drilbur","condition":null,"children":[{"id":530,"name":"Excadrill","condition":"Lv. 31","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[0,32],[1,10],[1,189],[1,229],[1,468],[12,154],[16,232],[20,201],[24,306],[28,157],[34,91],[40,14],[46,529],[52,89],[58,90]],"machine":[332,34,280,523,174,91,38,529,414,89,203,263,374,411,416,270,667,63,334,442,232,319,341,189,398,182,156,350,157,317,328,201,184,815,421,214,684,446,796,707,164,241,14,36,851,675,404],"egg":[319,163],"tutor":[]},"cards":[{"id":"zsv10pt5-168","name":"Excadrill ex","set":"Black Bolt","date":"2025-07-18","rarity":"Special Illustration Rare","number":"168","artist":"Mitsuhiro Arita","img":"zsv10pt5/168"},{"id":