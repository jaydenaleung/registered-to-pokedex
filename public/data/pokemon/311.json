{"id":311,"flavor":[{"games":["Alpha Sapphire","Sapphire"],"text":"When Plusle is cheering on its partner, it flashes with electric sparks from all over its body. If its partner loses, this Pokémon cries loudly."},{"games":["Omega Ruby","Ruby"],"text":"Plusle always acts as a cheerleader for its partners. Whenever a teammate puts out a good effort in battle, this Pokémon shorts out its body to create the crackling noises of sparks to show its joy."},{"games":["Y","SoulSilver","HeartGold"],"text":"It absorbs electricity from telephone poles. It shorts out its body to create crackling noises."},{"games":["X","White 2","Black 2","White","Black","Platinum","Pearl","Diamond"],"text":"It cheers on friends with pom-poms made of sparks. It drains power from telephone poles."},{"games":["LeafGreen","FireRed"],"text":"It cheers on partners while scattering sparks from its body. It climbs telephone poles to absorb electricity."},{"games":["Emerald"],"text":"It has the trait of cheering on its fellow POKéMON. By shorting out the electricity it releases from its paws, it creates pom-poms for cheering."}],"abilities":[{"name":"Plus","hidden":false,"description":"Boosts the Sp. Atk stat of the Pokémon if an ally with the Plus or Minus Ability is also in battle."},{"name":"Lightning Rod","hidden":true,"description":"The Pokémon draws in all Electric-type moves. Instead of taking damage from them, its Sp. Atk stat is boosted."}],"eggGroups":["Fairy"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium","habitat":"grassland","color":"Yellow","shape":"Upright","evolution":{"id":311,"name":"Plusle","condition":null,"children":[]},"moves":{"game":"Scarlet / Violet","level":[[1,45],[1,86],[1,98],[1,589],[4,270],[7,209],[10,227],[13,415],[16,129],[19,486],[22,383],[26,268],[31,435],[34,226],[37,97],[40,387],[43,87],[46,417],[49,494]],"machine":[97,914,226,268,451,204,598,604,486,527,227,283,203,263,313,374,447,270,113,189,417,583,182,240,156,285,214,164,162,129,851,87