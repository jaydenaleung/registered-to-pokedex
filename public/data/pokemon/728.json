{"id":728,"flavor":[{"games":["Shield"],"text":"If Popplio want to create big, powerful balloons, they must be persistent. It takes daily practice for these Pokémon to develop their skills."},{"games":["Sword"],"text":"It creates special bouncy balloons to send at its opponents. When the balloons pop, the sheer force of their bursting is what deals damage."},{"games":["Ultra Moon"],"text":"Popplio gets on top of its bouncy water balloons to jump higher. It’s quite the acrobatic fighter!"},{"games":["Ultra Sun"],"text":"The balloons it inflates with its nose grow larger and larger as it practices day by day."},{"games":["Moon"],"text":"This Pokémon can control water bubbles. It practices diligently so it can learn to make big bubbles."},{"games":["Sun"],"text":"This Pokémon snorts body fluids from its nose, blowing balloons to smash into its foes. It’s famous for being a hard worker."}],"abilities":[{"name":"Torrent","hidden":false,"description":"Powers up Water-type moves when the Pokémon's HP is low."},{"name":"Liquid Voice","hidden":true,"description":"Sound-based moves become Water-type moves."}],"eggGroups":["Water 1","Field"],"genderRate":1,"hatchCounter":15,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Blue","shape":"Fish","evolution":{"id":728,"name":"Popplio","condition":null,"children":[{"id":729,"name":"Brionne","condition":"Lv. 17","children":[{"id":730,"name":"Primarina","condition":"Lv. 34","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[1,1],[1,45],[3,55],[6,574],[9,453],[12,608],[15,196],[18,47],[21,61],[24,227],[27,581],[30,304],[33,585],[36,56]],"machine":[512,133,59,204,886,574,577,227,203,263,812,270,56,304,58,861,196,581,583,182,240,156,214,164,57,129,851,813,253,518,352,127,250],"egg":[392,791,195],"tutor":[]},"cards":[{"id":"me5-18","name":"Popplio","set":"Pitch Black","date":"2026-07-17","rarity":"Common","number":"18","artist":"Oswaldo KATO","small":"https://images.scrydex.com/pokemon/me5-18/small","lar