{"id":735,"flavor":[{"games":["Ultra Moon"],"text":"Patient by nature, this Pokémon loses control of itself and pounces when it spots its favorite meal—Rattata!"},{"games":["Ultra Sun"],"text":"Although it wasn’t originally found in Alola, this Pokémon was brought over a long time ago when there was a huge Rattata outbreak."},{"games":["Moon"],"text":"It adores having Rattata and Raticate for dinner, but as it’s diurnal, it never encounters them. This Pokémon boasts incredible patience."},{"games":["Sun"],"text":"When it finds a trace of its prey, it patiently stakes out the location...but it’s always snoozing by nightfall."}],"abilities":[{"name":"Stakeout","hidden":false,"description":"Doubles the damage dealt to a target that has just switched into battle."},{"name":"Strong Jaw","hidden":false,"description":"The Pokémon's strong jaw boosts the power of its biting moves."},{"name":"Adaptability","hidden":true,"description":"Powers up moves of the same type as the Pokémon."}],"eggGroups":["Field"],"genderRate":4,"hatchCounter":15,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Brown","shape":"Quadruped","evolution":{"id":734,"name":"Yungoos","condition":null,"children":[{"id":735,"name":"Gumshoos","condition":"Lv. 20 (Day)","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[1,28],[1,33],[1,43],[1,371],[13,526],[19,44],[23,189],[27,162],[31,36],[35,184],[39,242],[43,281],[47,37],[52,156]],"machine":[34,523,886,242,174,91,38,89,283,203,263,424,7,374,264,416,270,63,423,8,442,282,490,341,189,182,706,240,156,179,46,317,201,184,402,214,707,164,241,162,36,269,851,168,422,9,885,369,528,428],"egg":[],"tutor":[]},"cards":[{"id":"me1-153","name":"Gumshoos","set":"Mega Evolution","date":"2025-09-26","rarity":"Illustration Rare","number":"153","artist":null,"img":"me1/153"},{"id":"me1-110","name":"Gumshoos","set":"Mega Evolution","date":"2025-09-26","rarity":"Uncommon","number":"110","artist":null,"img":"me1/110"},{"id":"sv3-177","name":"Gumshoos","s