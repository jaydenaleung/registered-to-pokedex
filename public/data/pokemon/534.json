{"id":534,"flavor":[{"games":["Shield"],"text":"When going all out, this Pokémon throws aside its concrete pillars and leaps at opponents to pummel them with its fists."},{"games":["Sword"],"text":"Concrete mixed by Conkeldurr is much more durable than normal concrete, even when the compositions of the two materials are the same."},{"games":["Alpha Sapphire","Y","White 2","Black 2"],"text":"Rather than rely on force, they master moves that utilize the centrifugal force of spinning concrete."},{"games":["Omega Ruby","X","Black"],"text":"It is thought that Conkeldurr taught humans how to make concrete more than 2,000 years ago."},{"games":["White"],"text":"They use concrete pillars as walking canes. They know moves that enable them to swing the pillars freely in battle."}],"abilities":[{"name":"Guts","hidden":false,"description":"It's so gutsy that having a status condition boosts the Pokémon's Attack stat."},{"name":"Sheer Force","hidden":false,"description":"Removes any additional effects from the Pokémon's moves, but increases the moves' power."},{"name":"Iron Fist","hidden":true,"description":"Powers up punching moves."}],"eggGroups":["Human-Like"],"genderRate":2,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Brown","shape":"Humanoid","evolution":{"id":532,"name":"Timburr","condition":null,"children":[{"id":533,"name":"Gurdurr","condition":"Lv. 25","children":[{"id":534,"name":"Conkeldurr","condition":"Trade","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[1,1],[1,43],[1,67],[1,88],[12,116],[16,339],[20,157],[24,21],[30,184],[36,223],[42,359],[48,444],[54,276],[60,264]],"machine":[34,280,339,523,370,811,174,91,38,409,89,203,263,7,374,411,264,416,447,912,270,667,63,8,282,67,490,398,182,240,156,179,350,157,317,184,214,479,707,444,164,241,36,269,851,168,9,918],"egg":[68,432,197,183,469],"tutor":[]},"cards":[{"id":"zsv10pt5-127","name":"Conkeldurr","set":"Black Bolt","date":"2025-07-18","rarity":"Illustration Ra