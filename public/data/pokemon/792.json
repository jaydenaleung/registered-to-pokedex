{"id":792,"flavor":[{"games":["Shield"],"text":"It steals the light from its surroundings and then becomes the full moon, showering its own light across the night sky."},{"games":["Sword"],"text":"Known as the Beast That Calls the Moon, this Pokémon lives by taking in any and all light and converting it into its own energy."},{"games":["Ultra Moon"],"text":"It sometimes summons unknown powers and life-forms here to this world from holes that lead to other worlds."},{"games":["Ultra Sun"],"text":"Records of it exist in writings from long, long ago, where it was known by the name “the beast that calls the moon.”"},{"games":["Moon"],"text":"Said to live in another world, this Pokémon devours light, drawing the moonless dark veil of night over the brightness of day."},{"games":["Sun"],"text":"It is said to be a female evolution of Cosmog. When its third eye activates, away it flies to another world."}],"abilities":[{"name":"Shadow Shield","hidden":false,"description":"Reduces the amount of damage the Pokémon takes while its HP is full."}],"eggGroups":["Undiscovered"],"genderRate":-1,"hatchCounter":120,"baseHappiness":0,"growthRate":"slow","habitat":null,"color":"Purple","shape":"Wings","evolution":{"id":789,"name":"Cosmog","condition":null,"children":[{"id":790,"name":"Cosmoem","condition":"Lv. 43","children":[{"id":791,"name":"Solgaleo","condition":"Lv. 53","children":[]},{"id":792,"name":"Lunala","condition":"Lv. 53","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[0,714],[1,93],[1,95],[1,100],[1,322],[7,101],[14,109],[21,403],[28,247],[35,236],[42,539],[49,94],[56,585],[63,566],[70,138],[77,469]],"machine":[512,332,97,403,59,347,451,109,605,814,203,797,263,19,411,248,416,257,270,506,63,58,196,113,800,101,566,809,182,244,94,473,240,115,156,184,247,421,214,76,180,164,241,129,366,851,87,85,271,433,261],"egg":[],"tutor":[]},"cards":[{"id":"me55-80","name":"Lunala","set":"30th Celebration","date":"2026-09-16","rarity":"Rare","number":"80","artist":"Bun Touj