{"id":389,"flavor":[{"games":["Legends: Arceus"],"text":"This remarkable, large-bodied Pokémon would serve beautifully as borrowed scenery for a garden, and its strength is peerless. Torterra roams the wilderness in search of clean water."},{"games":["Alpha Sapphire","Y","Diamond"],"text":"Small Pokémon occasionally gather on its unmoving back to begin building their nests."},{"games":["Omega Ruby","X","SoulSilver","HeartGold"],"text":"Ancient people imagined that beneath the ground, a gigantic Torterra dwelled."},{"games":["White 2","Black 2","White","Black","Platinum"],"text":"Some Pokémon are born on a Torterra’s back and spend their entire life there."},{"games":["Pearl"],"text":"Groups of this Pokémon migrating in search of water have been mistaken for “moving forests.”"}],"abilities":[{"name":"Overgrow","hidden":false,"description":"Powers up Grass-type moves when the Pokémon's HP is low."},{"name":"Shell Armor","hidden":true,"description":"A hard shell protects the Pokémon from critical hits."}],"eggGroups":["Monster","Grass"],"genderRate":1,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Green","shape":"Quadruped","evolution":{"id":387,"name":"Turtwig","condition":null,"children":[{"id":388,"name":"Grotle","condition":"Lv. 18","children":[{"id":389,"name":"Torterra","condition":"Lv. 32","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[0,89],[1,33],[1,71],[1,75],[1,110],[1,452],[17,174],[22,44],[27,72],[33,73],[39,235],[45,242],[51,202],[57,437],[63,838]],"machine":[133,776,34,523,331,242,174,38,414,89,203,412,263,338,202,416,447,520,803,580,912,484,667,63,304,334,442,437,113,345,341,189,200,182,115,156,46,350,157,317,328,201,184,815,402,214,479,76,446,707,444,164,241,14,36,851,885,428],"egg":[38,74,504,255,254,276,256,37,321,469,388],"tutor":[]},"cards":[{"id":"sv5-12","name":"Torterra ex","set":"Temporal Forces","date":"2024-03-22","rarity":"Double Rare","number":"12","artist":"PLANETA Tsuji","img":"sv5