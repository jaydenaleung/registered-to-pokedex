{"id":667,"flavor":[{"games":["Ultra Moon"],"text":"This hot-blooded Pokémon is filled with curiosity. When it gets angry or starts fighting, its short mane gets hot."},{"games":["Ultra Sun"],"text":"When they’re young, they live with a pride. Once they’re able to hunt prey on their own, they’re kicked out and have to make their own way."},{"games":["Alpha Sapphire","Y"],"text":"They set off on their own from their pride and live by themselves to become stronger. These hot-blooded Pokémon are quick to fight."},{"games":["Omega Ruby","X"],"text":"The stronger the opponent it faces, the more heat surges from its mane and the more power flows through its body."}],"abilities":[{"name":"Rivalry","hidden":false,"description":"The Pokémon's competitive spirit makes it deal more damage to Pokémon of the same gender, but less damage to Pokémon of the opposite gender."},{"name":"Unnerve","hidden":false,"description":"Unnerves opposing Pokémon and makes them unable to eat Berries."},{"name":"Moxie","hidden":true,"description":"When the Pokémon knocks out a target, it shows moxie, which boosts its Attack stat."}],"eggGroups":["Field"],"genderRate":7,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Brown","shape":"Quadruped","evolution":{"id":667,"name":"Litleo","condition":null,"children":[{"id":668,"name":"Pyroar","condition":"Lv. 35","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[1,33],[1,43],[5,52],[8,526],[11,29],[15,568],[20,36],[23,424],[28,283],[33,497],[36,53],[39,242],[43,304],[46,510],[50,315]],"machine":[512,34,523,242,91,38,283,203,263,126,424,83,488,53,394,257,270,304,189,315,182,706,240,156,46,214,555,76,164,241,129,36,269,851,168,422,885,528,261],"egg":[494,83,394,281],"tutor":[]},"cards":[{"id":"me1-139","name":"Litleo","set":"Mega Evolution","date":"2025-09-26","rarity":"Illustration Rare","number":"139","artist":null,"img":"me1/139"},{"id":"me4-14","name":"Litleo","set":"Chaos Rising","date":"2026-05-22","r