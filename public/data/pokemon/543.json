{"id":543,"flavor":[{"games":["Shield"],"text":"Its fangs are highly venomous. If this Pokémon finds prey it thinks it can eat, it leaps for them without any thought of how things might turn out."},{"games":["Sword"],"text":"Venipede and Sizzlipede are similar species, but when the two meet, a huge fight ensues."},{"games":["Alpha Sapphire","Y","Black"],"text":"Its bite injects a potent poison, enough to paralyze large bird Pokémon that try to prey on it."},{"games":["Omega Ruby","X","White"],"text":"It discovers what is going on around it by using the feelers on its head and tail. It is brutally aggressive."},{"games":["White 2","Black 2"],"text":"Using the feelers on its head and tail, it picks up vibrations in the air to determine its prey’s location and state."}],"abilities":[{"name":"Poison Point","hidden":false,"description":"Contact with the Pokémon may poison the attacker."},{"name":"Swarm","hidden":false,"description":"Powers up Bug-type moves when the Pokémon's HP is low."},{"name":"Speed Boost","hidden":true,"description":"The Pokémon's Speed stat is boosted every turn."}],"eggGroups":["Bug"],"genderRate":4,"hatchCounter":15,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Red","shape":"Armor","evolution":{"id":543,"name":"Venipede","condition":null,"children":[{"id":544,"name":"Whirlipede","condition":"Lv. 22","children":[{"id":545,"name":"Scolipede","condition":"Lv. 30","children":[]}]}]},"moves":{"game":"Sword / Shield","level":[[1,40],[1,111],[4,205],[8,182],[12,342],[16,103],[20,450],[24,474],[28,36],[32,97],[36,92],[40,599],[44,38]],"machine":[97,213,203,263,360,506,334,371,42,398,182,156,496,103,214,188,173,76,191,164,241,390,599,474],"egg":[44,210],"tutor":[806,798]},"cards":[{"id":"zsv10pt5-132","name":"Venipede","set":"Black Bolt","date":"2025-07-18","rarity":"Illustration Rare","number":"132","artist":"Apios","img":"zsv10pt5/132"},{"id":"zsv10pt5-54","name":"Venipede","set":"Black Bolt","date":"2025-07-18","rarity":"Common"