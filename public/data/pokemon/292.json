{"id":292,"flavor":[{"games":["Shield","SoulSilver","HeartGold"],"text":"A strange Pokémon—it flies without moving its wings, has a hollow shell for a body, and does not breathe."},{"games":["Sword","Y","LeafGreen","FireRed"],"text":"A most peculiar Pokémon that somehow appears in a Poké Ball when a Nincada evolves."},{"games":["Alpha Sapphire","Sapphire"],"text":"Shedinja is a peculiar Pokémon. It seems to appear unsought in a Poké Ball after a Nincada evolves. This bizarre Pokémon is entirely immobile—it doesn’t even breathe."},{"games":["Omega Ruby","Ruby"],"text":"Shedinja’s hard body doesn’t move—not even a twitch. In fact, its body appears to be merely a hollow shell. It is believed that this Pokémon will steal the spirit of anyone peering into its hollow body from its back."},{"games":["X","White 2","Black 2","White","Black","Platinum","Pearl","Diamond"],"text":"A discarded bug shell that came to life. Peering into the crack on its back is said to steal one’s spirit."},{"games":["Emerald"],"text":"A peculiar POKéMON that floats in air even though its wings remain completely still. The inside of its body is hollow and utterly dark."}],"abilities":[{"name":"Wonder Guard","hidden":false,"description":"Its mysterious power only lets supereffective moves hit the Pokémon."}],"eggGroups":["Mineral"],"genderRate":-1,"hatchCounter":15,"baseHappiness":70,"growthRate":"erratic","habitat":"forest","color":"Brown","shape":"Blob","evolution":{"id":290,"name":"Nincada","condition":null,"children":[{"id":291,"name":"Ninjask","condition":"Lv. 20","children":[]},{"id":292,"name":"Shedinja","condition":"Lv. 20 with a spare party slot and Poké Ball","children":[]}]},"moves":{"game":"Sword / Shield","level":[[1,10],[1,28],[1,91],[1,106],[1,189],[1,206],[1,232],[1,288],[1,421],[15,109],[23,71],[29,425],[36,154],[43,170],[50,247],[57,180],[64,566]],"machine":[97,502,405,91,203,263,206,202,416,506,63,141,566,182,156,496,201,247,421,214,173,76,164,241,168,271,261,404],"egg":[],"tutor