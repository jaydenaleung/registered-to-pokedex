{"id":766,"flavor":[{"games":["Shield"],"text":"Passimian live in groups of about 20, with each member performing an assigned role. Through cooperation, the group survives."},{"games":["Sword"],"text":"Displaying amazing teamwork, they follow the orders of their boss as they all help out in the search for their favorite berries."},{"games":["Ultra Moon"],"text":"Berries are its weapons as well as the staple of its diet. The one that can throw a berry the farthest is the boss of the troop."},{"games":["Ultra Sun"],"text":"They use their saliva to stick leaves to their shoulders. You can tell what troop they belong to from the position of the leaves."},{"games":["Moon"],"text":"They battle with hard berries for weapons. Their techniques are passed from the boss to the group, generation upon generation."},{"games":["Sun"],"text":"They form groups of roughly 20 individuals. Their mutual bond is remarkable—they will never let down a comrade."}],"abilities":[{"name":"Receiver","hidden":false,"description":"The Pokémon copies the Ability of a defeated ally."},{"name":"Defiant","hidden":true,"description":"If the Pokémon has any stat lowered by an opposing Pokémon, its Attack stat will be boosted sharply."}],"eggGroups":["Field"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"slow","habitat":null,"color":"White","shape":"Upright","evolution":{"id":766,"name":"Passimian","condition":null,"children":[]},"moves":{"game":"Scarlet / Violet","level":[[1,33],[1,43],[5,249],[10,116],[15,251],[20,184],[25,36],[30,374],[35,339],[40,37],[45,38],[50,370],[55,179],[60,416]],"machine":[512,226,34,280,339,523,886,370,811,174,38,409,89,527,203,412,263,374,411,264,416,447,441,360,63,442,282,67,490,220,182,240,156,179,157,317,184,402,247,214,479,164,241,36,269,851,168,885,369,918,253,410],"egg":[68,364,282,98,501,69],"tutor":[]},"cards":[{"id":"sv8-111","name":"Passimian","set":"Surging Sparks","date":"2024-11-08","rarity":"Uncommon","number":"111","artist":null,"img":"sv8