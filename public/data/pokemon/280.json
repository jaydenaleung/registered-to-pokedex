{"id":280,"flavor":[{"games":["Legends: Arceus"],"text":"Tends to prefer people with a chipper disposition to those who are gloomy, but it has shown no discrimination with regard to age or gender. Needs more research."},{"games":["Shield","X","White 2","Black 2","White","Black","Platinum"],"text":"If its horns capture the warm feelings of people or Pokémon, its body warms up slightly."},{"games":["Sword","Y","LeafGreen","FireRed"],"text":"It is highly attuned to the emotions of people and Pokémon. It hides if it senses hostility."},{"games":["Alpha Sapphire","Sapphire"],"text":"Ralts has the ability to sense the emotions of people. If its Trainer is in a cheerful mood, this Pokémon grows cheerful and joyous in the same way."},{"games":["Omega Ruby","Ruby"],"text":"Ralts senses the emotions of people using the horns on its head. This Pokémon rarely appears before people. But when it does, it draws closer if it senses that the person has a positive disposition."},{"games":["SoulSilver","HeartGold"],"text":"The horns on its head provide a strong power that enables it to sense people’s emotions."},{"games":["Pearl","Diamond"],"text":"It uses the horns on its head to sense human emotions. It is said to appear in front of cheerful people."},{"games":["Emerald"],"text":"A RALTS has the power to sense the emotions of people and POKéMON with the horns on its head. It takes cover if it senses any hostility."}],"abilities":[{"name":"Synchronize","hidden":false,"description":"If the Pokémon is burned, paralyzed, or poisoned by another Pokémon, that Pokémon will be inflicted with the same status condition."},{"name":"Trace","hidden":false,"description":"When it enters a battle, the Pokémon copies an opposing Pokémon's Ability."},{"name":"Telepathy","hidden":true,"description":"The Pokémon anticipates and dodges the attacks of its allies."}],"eggGroups":["Human-Like","Amorphous"],"genderRate":4,"hatchCounter":20,"baseHappiness":35,"growthRate":"slow","habitat":"urban","color":"White","shape":"Humanoid","evolution":{"id":280,"name":"Ralts","condition":null,"children":[{"id":281,"name":"Kirlia","condition":"Lv. 20","children":[{"id":282,"name":"Gardevoir","condition":"Lv. 30","children":[]},{"id":475,"name":"Gallade","condition":"Use Dawn Stone (male)","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[1,45],[1,574],[3,104],[6,93],[9,95],[12,577],[15,100],[18,60],[21,791],[24,204],[27,347],[30,94],[33,505],[36,138],[39,248]],"machine":[914,34,347,451,204,109,605,574,577,227,203,797,263,7,374,248,447,270,304,8,196,286,282,113,345,118,581,220,182,60,244,94,678,473,240,115,156,247,285,214,500,164,241,129,269,851,168,9,86,85,271,433,261,428],"egg":[109,194,50,282,212,262,595,425],"tutor":[]},"cards":[{"id":"sv1-211","name":"Ralts","set":"Scarlet & Violet","date":"2023-03-31","rarity":"Illustration Rare","number":"211","artist":"Jiro Sasumo","img":"sv1/211"},{"id":"me2pt5-87","name":"Ralts","set":"Ascended Heroes","date":"2026-01-30","rarity":"Common","number":"87","artist":"Terada Tera","small":"https://images.scrydex.com/pokemon/me2pt5-87/small","large":"https://images.scrydex.com/pokemon/me2pt5-87/large"},{"id":"me1-58","name":"Ralts","set":"Mega Evolution","date":"2025-09-26","rarity":"Common","number":"58","artist":null,"img":"me1/58"},{"id":"sv4pt5-27","name":"Ralts","set":"Paldean Fates","date":"2024-01-26","rarity":"Common","number":"27","artist":"Tika Matsuno","img":"sv4pt5/27"},{"id":"sv4pt5-153","name":"Ralts","set":"Paldean Fates","date":"2024-01-26","rarity":"Shiny Rare","number":"153","artist":"yuu","img":"sv4pt5/153"},{"id":"sv1-84","name":"Ralts","set":"Scarlet & Violet","date":"2023-03-31","rarity":"Common","number":"84","artist":"Tika Matsuno","img":"sv1/84"},{"id":"swsh12-67","name":"Ralts","set":"Silver Tempest","date":"2022-11-11","rarity":"Common","number":"67","artist":"Nagomi Nijo","img":"swsh12/67"},{"id":"swsh10-60","name":"Ralts","set":"Astral Radiance","date":"2022-05-27","rarity":"Common","number":"60","ar