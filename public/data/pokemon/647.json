{"id":647,"flavor":[{"games":["Shield"],"text":"They say that Keldeo must survive harsh battles and fully develop the horn on its forehead before this Pokémon’s true power will awaken."},{"games":["Sword"],"text":"Cobalion, Terrakion, and Virizion taught this Pokémon how to fight. It dashes across the world, seeking more opportunities to further its training."},{"games":["Alpha Sapphire","Y","White 2","Black 2"],"text":"When it is resolute, its body fills with power and it becomes swifter. Its jumps are then too fast to follow."},{"games":["Omega Ruby","X","White"],"text":"It crosses the world, running over the surfaces of oceans and rivers. It appears at scenic waterfronts."},{"games":["Black"],"text":"By blasting water from its hooves, it can glide across water. It excels at using leg moves while battling."}],"abilities":[{"name":"Justified","hidden":false,"description":"When the Pokémon is hit by a Dark-type attack, its Attack stat is boosted by its sense of justice."}],"eggGroups":["Undiscovered"],"genderRate":-1,"hatchCounter":80,"baseHappiness":35,"growthRate":"slow","habitat":null,"color":"Yellow","shape":"Quadruped","evolution":{"id":647,"name":"Keldeo","condition":null,"children":[]},"moves":{"game":"Scarlet / Violet","level":[[1,43],[1,270],[1,453],[1,526],[1,548],[7,61],[14,501],[21,24],[28,514],[35,401],[42,36],[49,533],[56,14],[63,56],[70,370]],"machine":[332,403,396,226,280,347,886,370,811,38,203,263,206,812,411,416,270,56,63,196,710,67,330,220,398,182,244,240,115,156,179,46,214,684,444,164,241,57,129,14,36,269,851,885,918,410,352,404],"egg":[],"tutor":[]},"cards":[{"id":"rsv10pt5-167","name":"Keldeo ex","set":"White Flare","date":"2025-07-18","rarity":"Special Illustration Rare","number":"167","artist":"Yuu Nishida","img":"rsv10pt5/167"},{"id":"me4-19","name":"Keldeo","set":"Chaos Rising","date":"2026-05-22","rarity":"Rare","number":"19","artist":"Mitsuhiro Arita","small":"https://images.scrydex.com/pokemon/me4-19/small","large":"https://images.scryde