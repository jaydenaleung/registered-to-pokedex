{"id":802,"flavor":[{"games":["Shield"],"text":"This Pokémon can conceal itself in any shadow, so it went undiscovered for a long time."},{"games":["Sword"],"text":"By slipping into the shadow of a martial arts master and copying their movements, this Pokémon learned the ultimate techniques."},{"games":["Ultra Moon"],"text":"It sinks into the shadows of people and Pokémon, where it can understand their feelings and copy their capabilities."},{"games":["Ultra Sun"],"text":"It slips into the shadows of others and mimics their powers and movements. As it improves, it becomes stronger than those it’s imitating."},{"games":["Moon"],"text":"It lurks in the shadows of others, copying their movements and powers. This Pokémon is craven and cowering."},{"games":["Sun"],"text":"Able to conceal itself in shadows, it never appears before humans, so its very existence was the stuff of myth."}],"abilities":[{"name":"Technician","hidden":false,"description":"Powers up weak moves so the Pokémon can deal more damage with them."}],"eggGroups":["Undiscovered"],"genderRate":-1,"hatchCounter":120,"baseHappiness":0,"growthRate":"slow","habitat":null,"color":"Gray","shape":"Humanoid","evolution":{"id":802,"name":"Marshadow","condition":null,"children":[]},"moves":{"game":"Sword / Shield","level":[[1,7],[1,8],[1,9],[1,68],[1,364],[1,383],[1,425],[9,272],[18,325],[27,395],[36,372],[45,389],[54,409],[63,244],[72,712],[81,673],[90,283],[99,370]],"machine":[512,97,372,396,299,340,280,339,347,370,409,203,263,206,7,374,411,492,416,447,506,63,8,442,67,490,25,5,200,371,566,398,182,156,279,179,157,317,496,247,421,214,173,444,164,276,129,168,675,9,261,526,428],"egg":[],"tutor":[811,809,806]},"cards":[{"id":"me1-146","name":"Marshadow","set":"Mega Evolution","date":"2025-09-26","rarity":"Illustration Rare","number":"146","artist":null,"img":"me1/146"},{"id":"me5-40","name":"Marshadow","set":"Pitch Black","date":"2026-07-17","rarity":"Uncommon","number":"40","artist":"Nakamura Ippan","small":"https://i