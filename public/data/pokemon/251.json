{"id":251,"flavor":[{"games":["Shield"],"text":"This Pokémon traveled through time to come from the future. It bolsters grass and trees with its own strength, and it can heal wounds, too."},{"games":["Sword"],"text":"This Pokémon has the ability to move through time. Records describing it as a forest deity can be found from many different eras."},{"games":["Alpha Sapphire","Omega Ruby","Emerald","Sapphire","Ruby"],"text":"This Pokémon came from the future by crossing over time. It is thought that so long as Celebi appears, a bright and shining future awaits us."},{"games":["Y","White 2","Black 2","White","Black","Platinum","Pearl","Diamond"],"text":"It has the power to travel across time, but it is said to appear only in peaceful times."},{"games":["X","HeartGold","LeafGreen","Gold"],"text":"This Pokémon wanders across time. Grass and trees flourish in the forests in which it has appeared."},{"games":["SoulSilver","FireRed","Silver"],"text":"When CELEBI disappears deep in a forest, it is said to leave behind an egg it brought from the future."},{"games":["Crystal"],"text":"Revered as a guardian of the forest, CELEBI appears wherever beautiful forests exist."}],"abilities":[{"name":"Natural Cure","hidden":false,"description":"The Pokémon's status conditions are cured when it switches out."}],"eggGroups":["Undiscovered"],"genderRate":-1,"hatchCounter":120,"baseHappiness":100,"growthRate":"medium slow","habitat":"forest","color":"Green","shape":"Humanoid","evolution":{"id":251,"name":"Celebi","condition":null,"children":[]},"moves":{"game":"Sword / Shield","level":[[1,93],[1,215],[10,345],[20,226],[30,246],[40,791],[50,73],[60,105],[70,248],[80,361],[90,437],[100,195]],"machine":[502,396,226,347,605,414,203,412,263,374,248,202,416,447,580,270,63,286,348,437,113,478,345,118,417,676,182,94,678,427,240,115,156,496,219,201,402,247,285,214,173,76,669,446,164,241,129,14,86,271,433,369,253,311,472,428],"egg":[],"tutor":[814,797,803]},"cards":[{"id":"me55c-106","name":"Shining Celebi","set":"30th Celebration: Classic Collection","date":"2026-09-16","rarity":"Rare Secret","number":"106","artist":"Hironobu Yoshida","small":"https://images.scrydex.com/pokemon/me55c-106/small","large":"https://images.scrydex.com/pokemon/me55c-106/large"},{"id":"me1-12","name":"Celebi","set":"Mega Evolution","date":"2025-09-26","rarity":"Uncommon","number":"12","artist":null,"img":"me1/12"},{"id":"sv7-4","name":"Celebi","set":"Stellar Crown","date":"2024-09-13","rarity":"Uncommon","number":"4","artist":null,"img":"sv7/4"},{"id":"swsh8-245","name":"Celebi V","set":"Fusion Strike","date":"2021-11-12","rarity":"Rare Ultra","number":"245","artist":"Teeziro","img":"swsh8/245"},{"id":"swsh6-7","name":"Celebi V","set":"Chilling Reign","date":"2021-06-18","rarity":"Rare Holo V","number":"7","artist":"AKIRA EGAWA","img":"swsh6/7"},{"id":"swsh6-8","name":"Celebi VMAX","set":"Chilling Reign","date":"2021-06-18","rarity":"Rare Holo VMAX","number":"8","artist":"PLANETA Tsuji","img":"swsh6/8"},{"id":"swsh6-160","name":"Celebi V","set":"Chilling Reign","date":"2021-06-18","rarity":"Rare Ultra","number":"160","artist":"PLANETA Tsuji","img":"swsh6/160"},{"id":"swsh6-199","name":"Celebi VMAX","set":"Chilling Reign","date":"2021-06-18","rarity":"Rare Rainbow","number":"199","artist":"PLANETA Tsuji","img":"swsh6/199"},{"id":"swsh45-3","name":"Celebi","set":"Shining Fates","date":"2021-02-19","rarity":"Rare","number":"3","artist":"Yuu Nishida","img":"swsh45/3"},{"id":"swsh4-9","name":"Celebi","set":"Vivid Voltage","date":"2020-11-13","rarity":"Amazing Rare","number":"9","artist":"5ban Graphics","img":"swsh4/9"},{"id":"swsh1-1","name":"Celebi V","set":"Sword & Shield","date":"2020-02-07","rarity":"Rare Holo V","number":"1","artist":"PLANETA Igarashi","img":"swsh1/1"},{"id":"sm11-4","name":"Celebi","set":"Unified Minds","date":"2019-08-02","rarity":"Rare Holo","number":"4","artist":"Megumi Mizutani","img":"sm11/4"},{"id":"sm9-1","name":"Celebi & Venusaur-GX","set":"Team Up","date":