{"id":493,"flavor":[{"games":["Legends: Arceus"],"text":"It is the heavenly fount from which pours the light that shines across Hisui. Its luminance guides and protects all Pokémon. Hisuian mythology states that Arceus is the creator of all things."},{"games":["Alpha Sapphire","Y","Pearl"],"text":"It is told in mythology that this Pokémon was born before the universe even existed."},{"games":["Omega Ruby","X","SoulSilver","HeartGold"],"text":"According to the legends of Sinnoh, this Pokémon emerged from an egg and shaped all there is in this world."},{"games":["White 2","Black 2","White","Black","Platinum"],"text":"It is said to have emerged from an egg in a place where there was nothing then shaped the world."},{"games":["Diamond"],"text":"It is described in mythology as the Pokémon that shaped the universe with its 1,000 arms."}],"abilities":[{"name":"Multitype","hidden":false,"description":"Changes the Pokémon's type to match the plate it holds."}],"eggGroups":["Undiscovered"],"genderRate":-1,"hatchCounter":120,"baseHappiness":0,"growthRate":"slow","habitat":null,"color":"White","shape":"Quadruped","evolution":{"id":493,"name":"Arceus","condition":null,"children":[]},"moves":{"game":"Scarlet / Violet","level":[[1,69],[1,322],[10,356],[20,414],[30,304],[40,245],[50,361],[60,248],[70,105],[80,63],[90,195],[100,449]],"machine":[491,97,403,396,419,59,776,34,280,405,339,523,331,347,451,886,109,399,605,38,434,337,349,406,525,414,89,604,203,412,263,126,53,394,430,19,411,492,248,202,416,447,580,356,441,257,484,506,542,56,63,304,58,196,286,334,442,113,710,345,800,581,200,315,566,398,408,182,244,94,678,473,240,115,156,46,157,317,201,184,815,247,421,214,188,555,76,446,796,707,444,500,164,241,916,57,129,14,366,36,269,851,87,86,85,885,271,433,352,127,528,261,404,428],"egg":[],"tutor":[]},"cards":[{"id":"me55c-123","name":"Arceus VSTAR","set":"30th Celebration: Classic Collection","date":"2026-09-16","rarity":"Holo Rare VSTAR","number":"123","artist":"5ban Graphics","small":"h