{"id":556,"flavor":[{"games":["Shield"],"text":"Once each year, this Pokémon scatters its seeds. They’re jam-packed with nutrients, making them a precious food source out in the desert."},{"games":["Sword"],"text":"With noises that could be mistaken for the rattles of maracas, it creates an upbeat rhythm, startling bird Pokémon and making them fly off in a hurry."},{"games":["Alpha Sapphire","Y","White"],"text":"Arid regions are their habitat. They move rhythmically, making a sound similar to maracas."},{"games":["Omega Ruby","X","Black"],"text":"It uses an up-tempo song and dance to drive away the bird Pokémon that prey on its flower seeds."},{"games":["White 2","Black 2"],"text":"When it moves rhythmically, it makes a sound similar to maracas, making the surprised Pokémon flee."}],"abilities":[{"name":"Water Absorb","hidden":false,"description":"If hit by a Water-type move, the Pokémon has its HP restored instead of taking damage."},{"name":"Chlorophyll","hidden":false,"description":"Boosts the Pokémon's Speed stat in harsh sunlight."},{"name":"Storm Drain","hidden":true,"description":"The Pokémon draws in all Water-type moves. Instead of taking damage from them, its Sp. Atk stat is boosted."}],"eggGroups":["Grass"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Green","shape":"Blob","evolution":{"id":556,"name":"Maractus","condition":null,"children":[]},"moves":{"game":"Sword / Shield","level":[[1,64],[1,71],[1,275],[1,495],[1,596],[4,74],[8,72],[12,73],[16,389],[20,42],[24,202],[28,230],[32,235],[36,572],[40,178],[44,241],[48,76],[52,367],[56,80],[60,538]],"machine":[372,213,340,331,409,203,412,263,202,447,580,270,304,437,42,398,182,240,156,496,219,103,402,214,173,76,191,164,241,675,253,311],"egg":[452,388],"tutor":[803]},"cards":[{"id":"zsv10pt5-93","name":"Maractus","set":"Black Bolt","date":"2025-07-18","rarity":"Illustration Rare","number":"93","artist":"Heisuke Kitazawa","img":"zsv10pt5/93"},{"id":"zsv10pt5