{"id":253,"flavor":[{"games":["Alpha Sapphire","Sapphire"],"text":"This Pokémon adeptly flies from branch to branch in trees. In a forest, no Pokémon can ever hope to catch a fleeing Grovyle however fast they may be."},{"games":["Omega Ruby","Ruby"],"text":"The leaves growing out of Grovyle’s body are convenient for camouflaging it from enemies in the forest. This Pokémon is a master at climbing trees in jungles."},{"games":["Y","White 2","Black 2","White","Black","Platinum","Pearl","Diamond"],"text":"It lives in dense jungles. While closing in on its prey, it leaps from branch to branch."},{"games":["X","LeafGreen","FireRed"],"text":"Its strongly developed thigh muscles give it astounding agility and jumping performance."},{"games":["SoulSilver","HeartGold"],"text":"It leaps from tree branch to tree branch quite swiftly. It shows astounding agility."},{"games":["Emerald"],"text":"Leaves grow out of this POKéMON’s body. They help obscure a GROVYLE from the eyes of its enemies while it is in a thickly overgrown forest."}],"abilities":[{"name":"Overgrow","hidden":false,"description":"Powers up Grass-type moves when the Pokémon's HP is low."},{"name":"Unburden","hidden":true,"description":"Boosts the Speed stat if the Pokémon's held item is used or lost."}],"eggGroups":["Monster","Dragon"],"genderRate":1,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":"forest","color":"Green","shape":"Upright","evolution":{"id":252,"name":"Treecko","condition":null,"children":[{"id":253,"name":"Grovyle","condition":"Lv. 16","children":[{"id":254,"name":"Sceptile","condition":"Lv. 36","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[1,1],[1,43],[1,98],[1,670],[9,72],[12,197],[15,501],[20,372],[25,202],[30,21],[35,104],[40,348],[45,103],[50,283],[55,437]],"machine":[512,332,97,784,280,331,242,91,525,409,283,203,412,263,206,374,264,202,447,520,803,580,270,437,67,490,345,182,156,157,317,402,214,76,164,241,129,14,36,851,168,9,885,918,410,404],"egg":[