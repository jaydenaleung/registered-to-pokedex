{"id":775,"flavor":[{"games":["Ultra Moon"],"text":"It remains asleep from birth to death as a result of the sedative properties of the leaves that form its diet."},{"games":["Ultra Sun"],"text":"It stays asleep from the moment it’s born. When it falls into a deep sleep, it stops moving altogether."},{"games":["Moon"],"text":"The log it holds was given to it by its parents at birth. It has also been known to cling to the arm of a friendly Trainer."},{"games":["Sun"],"text":"It is born asleep, and it dies asleep. All its movements are apparently no more than the results of it tossing and turning in its dreams."}],"abilities":[{"name":"Comatose","hidden":false,"description":"The Pokémon is always drowsing and will never wake up. It can attack while in its sleeping state."}],"eggGroups":["Field"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"slow","habitat":null,"color":"Blue","shape":"Humanoid","evolution":{"id":775,"name":"Komala","condition":null,"children":[]},"moves":{"game":"Scarlet / Violet","level":[[1,111],[1,205],[6,254],[6,255],[6,256],[11,229],[16,281],[21,21],[26,175],[31,389],[36,244],[41,452],[46,37]],"machine":[512,34,280,339,523,347,204,174,38,89,283,203,263,374,416,441,63,861,442,282,67,490,232,583,182,244,240,179,157,317,402,421,214,707,164,241,162,14,36,851,168,885,369,428],"egg":[204,583,47,276,273],"tutor":[]},"cards":[{"id":"me2pt5-175","name":"Larry's Komala","set":"Ascended Heroes","date":"2026-01-30","rarity":"Common","number":"175","artist":"ryoma uratsuka","small":"https://images.scrydex.com/pokemon/me2pt5-175/small","large":"https://images.scrydex.com/pokemon/me2pt5-175/large"},{"id":"sv9-129","name":"Komala","set":"Journey Together","date":"2025-03-28","rarity":"Common","number":"129","artist":null,"img":"sv9/129"},{"id":"swsh11-149","name":"Komala","set":"Lost Origin","date":"2022-09-09","rarity":"Uncommon","number":"149","artist":"HYOGONOSUKE","img":"swsh11/149"},{"id":"sm11-185","name":"Komala","set":"Unified Minds",