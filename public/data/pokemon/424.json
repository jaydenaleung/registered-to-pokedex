{"id":424,"flavor":[{"games":["Legends: Arceus"],"text":"To affirm their kinship, members of this species will form a ring by linking their newly doubled tails together. On rare occasions, humans have been accepted into such rings."},{"games":["Ultra Moon"],"text":"It uses its tails for everything. If it wraps both of its tails around you and gives you a squeeze, that’s proof it really likes you."},{"games":["Ultra Sun"],"text":"In their search for comfortable trees, they get into territorial disputes with groups of Passimian. They win about half the time."},{"games":["Alpha Sapphire","Y","Diamond"],"text":"To eat, it deftly shucks nuts with its two tails. It rarely uses its arms now."},{"games":["Omega Ruby","X","Pearl"],"text":"They work in large colonies and make rings by linking their tails, apparently in friendship."},{"games":["White 2","Black 2","White","Black","Platinum"],"text":"Split into two, the tails are so adept at handling and doing things, Ambipom rarely uses its hands."},{"games":["SoulSilver"],"text":"It is very difficult to dodge the consecutive strikes of its two tails."},{"games":["HeartGold"],"text":"They live on large trees. They are said to communicate by connecting their tails to those of others."}],"abilities":[{"name":"Technician","hidden":false,"description":"Powers up weak moves so the Pokémon can deal more damage with them."},{"name":"Pickup","hidden":false,"description":"The Pokémon may pick up an item another Pokémon used during a battle. It may pick up items outside of battle, too."},{"name":"Skill Link","hidden":true,"description":"Maximizes the number of times multistrike moves hit."}],"eggGroups":["Field"],"genderRate":4,"hatchCounter":20,"baseHappiness":100,"growthRate":"fast","habitat":null,"color":"Purple","shape":"Upright","evolution":{"id":190,"name":"Aipom","condition":null,"children":[{"id":424,"name":"Ambipom","condition":"Level up, knowing Double Hit","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[1,10],[1,