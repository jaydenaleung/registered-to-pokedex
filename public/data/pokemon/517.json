{"id":517,"flavor":[{"games":["Shield"],"text":"It eats dreams and releases mist. The mist is pink when it’s eating a good dream, and black when it’s eating a nightmare."},{"games":["Sword"],"text":"Late at night, it appears beside people’s pillows. As it feeds on dreams, the patterns on its body give off a faint glow."},{"games":["Alpha Sapphire","Y","White"],"text":"It eats the dreams of people and Pokémon. When it eats a pleasant dream, it expels pink-colored mist."},{"games":["Omega Ruby","X","White 2","Black 2"],"text":"This Pokémon appears before people and Pokémon who are having nightmares and eats those dreams."},{"games":["Black"],"text":"Munna always float in the air. People whose dreams are eaten by them forget what the dreams had been about."}],"abilities":[{"name":"Forewarn","hidden":false,"description":"When it enters a battle, the Pokémon can tell one of the moves an opposing Pokémon has."},{"name":"Synchronize","hidden":false,"description":"If the Pokémon is burned, paralyzed, or poisoned by another Pokémon, that Pokémon will be inflicted with the same status condition."},{"name":"Telepathy","hidden":true,"description":"The Pokémon anticipates and dodges the attacks of its allies."}],"eggGroups":["Field"],"genderRate":4,"hatchCounter":10,"baseHappiness":70,"growthRate":"fast","habitat":null,"color":"Pink","shape":"Quadruped","evolution":{"id":517,"name":"Munna","condition":null,"children":[{"id":518,"name":"Musharna","condition":"Use Moon Stone","children":[]}]},"moves":{"game":"Sword / Shield","level":[[1,111],[1,500],[4,95],[8,60],[12,286],[16,236],[20,277],[24,428],[28,347],[32,281],[36,94],[40,585],[44,138],[48,248],[52,472]],"machine":[502,133,213,347,605,203,412,263,248,385,360,270,286,113,384,182,94,473,240,115,156,157,317,496,219,247,285,214,173,500,164,129,86,271,433,472,428],"egg":[174,361],"tutor":[797]},"cards":[{"id":"zsv10pt5-116","name":"Munna","set":"Black Bolt","date":"2025-07-18","rarity":"Illustration Rare","number":"116","artist":