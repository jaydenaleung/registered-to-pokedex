{"id":613,"flavor":[{"games":["Shield"],"text":"It sniffles before performing a move, using its frosty snot to provide an icy element to any move that needs it."},{"games":["Sword"],"text":"When this Pokémon is in good health, its snot becomes thicker and stickier. It will smear its snot on anyone it doesn’t like."},{"games":["Alpha Sapphire","Y","White 2","Black 2"],"text":"Their snot is a barometer of health. When healthy, their snot is sticky and the power of their ice moves increases."},{"games":["Omega Ruby","X","White"],"text":"Its nose is always running. It sniffs the snot back up because the mucus provides the raw material for its moves."},{"games":["Black"],"text":"When it is not feeling well, its mucus gets watery and the power of its Ice-type moves decreases."}],"abilities":[{"name":"Snow Cloak","hidden":false,"description":"Boosts the Pokémon's evasiveness in snow."},{"name":"Slush Rush","hidden":false,"description":"Boosts the Pokémon's Speed stat in snow."},{"name":"Rattled","hidden":true,"description":"The Pokémon gets scared when hit by a Dark-, Ghost-, or Bug-type attack or if intimidated, which boosts its Speed stat."}],"eggGroups":["Field"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"White","shape":"Upright","evolution":{"id":613,"name":"Cubchoo","condition":null,"children":[{"id":614,"name":"Beartic","condition":"Lv. 37","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[1,45],[1,181],[3,203],[6,154],[9,196],[12,589],[15,362],[18,524],[21,163],[24,175],[27,204],[30,883],[33,37],[36,156],[39,59],[42,329]],"machine":[332,419,59,776,34,523,204,886,242,91,227,283,203,263,374,264,447,484,58,423,8,333,196,710,67,232,341,189,583,182,240,156,157,317,421,214,555,883,164,57,36,269,851,168,885,352,404],"egg":[264,400,281],"tutor":[]},"cards":[{"id":"zsv10pt5-109","name":"Cubchoo","set":"Black Bolt","date":"2025-07-18","rarity":"Illustration Rare","number":"109","artist":"osare","img":"zsv10pt5