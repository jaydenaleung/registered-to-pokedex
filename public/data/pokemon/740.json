{"id":740,"flavor":[{"games":["Ultra Moon"],"text":"Before it stops to think, it just starts pummeling. There are records of its turning back avalanches with a flurry of punches."},{"games":["Ultra Sun"],"text":"It stores coldness in its pincers and pummels its foes. It can even smash thick walls of ice to bits!"},{"games":["Moon"],"text":"It just throws punches indiscriminately. In times of desperation, it can lop off its own pincers and fire them like rockets."},{"games":["Sun"],"text":"It aimed for the top but got lost and ended up on a snowy mountain. Being forced to endure the cold, this Pokémon evolved and grew fur."}],"abilities":[{"name":"Hyper Cutter","hidden":false,"description":"The Pokémon's prized, mighty pincers prevent other Pokémon from lowering its Attack stat."},{"name":"Iron Fist","hidden":false,"description":"Powers up punching moves."},{"name":"Anger Point","hidden":true,"description":"The Pokémon is angered when it takes a critical hit, and that maxes its Attack stat."}],"eggGroups":["Water 3"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"White","shape":"Armor","evolution":{"id":739,"name":"Crabrawler","condition":null,"children":[{"id":740,"name":"Crabominable","condition":"Level up at Mount Lanakila or Use Ice Stone","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[0,8],[1,43],[1,182],[1,249],[17,61],[22,280],[25,21],[29,419],[33,179],[37,665],[42,334],[45,223],[49,370]],"machine":[133,419,59,776,34,280,339,523,886,370,811,91,409,89,283,203,263,374,411,264,416,441,912,270,63,58,8,861,196,334,442,282,710,341,189,182,240,156,179,157,317,184,214,883,707,164,241,129,36,851,168,9,918,428],"egg":[],"tutor":[]},"cards":[{"id":"sv7-149","name":"Crabominable","set":"Stellar Crown","date":"2024-09-13","rarity":"Illustration Rare","number":"149","artist":null,"img":"sv7/149"},{"id":"sv7-42","name":"Crabominable","set":"Stellar Crown","date":"2024-09-13","rarity":"Uncommon","number":"42","