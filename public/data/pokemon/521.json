{"id":521,"flavor":[{"games":["Shield"],"text":"This Pokémon is intelligent and intensely proud. People will sit up and take notice if you become the Trainer of one."},{"games":["Sword"],"text":"Unfezant are exceptional fliers. The females are known for their stamina, while the males outclass them in terms of speed."},{"games":["Alpha Sapphire","Y","White"],"text":"Males have plumage on their heads. They will never let themselves feel close to anyone other than their Trainers."},{"games":["Omega Ruby","X","Black"],"text":"Males swing their head plumage to threaten opponents. The females’ flying abilities surpass those of the males."},{"games":["White 2","Black 2"],"text":"Males swing the plumage on their heads to threaten others, but females are better at flying."}],"abilities":[{"name":"Big Pecks","hidden":false,"description":"Prevents the Pokémon from having its Defense stat lowered."},{"name":"Super Luck","hidden":false,"description":"The Pokémon is so lucky that the critical-hit ratios of its moves are boosted."},{"name":"Rivalry","hidden":true,"description":"The Pokémon's competitive spirit makes it deal more damage to Pokémon of the same gender, but less damage to Pokémon of the opposite gender."}],"eggGroups":["Flying"],"genderRate":4,"hatchCounter":15,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Gray","shape":"Wings","evolution":{"id":519,"name":"Pidove","condition":null,"children":[{"id":520,"name":"Tranquill","condition":"Lv. 21","children":[{"id":521,"name":"Unfezant","condition":"Lv. 32","children":[]}]}]},"moves":{"game":"Sword / Shield","level":[[1,16],[1,43],[1,45],[1,98],[12,269],[16,314],[20,207],[26,297],[36,197],[42,403],[50,355],[58,366],[66,143]],"machine":[97,403,213,413,203,263,19,116,416,257,542,63,182,240,156,496,214,173,211,164,241,129,269,369,253,526],"egg":[],"tutor":[814]},"cards":[{"id":"zsv10pt5-150","name":"Unfezant","set":"Black Bolt","date":"2025-07-18","rarity":"Illustration Rare","number":"150","artist":"Y