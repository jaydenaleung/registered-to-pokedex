{"id":769,"flavor":[{"games":["Shield"],"text":"Sandygast mainly inhabits beaches. It takes control of anyone who puts their hand into its mouth, forcing them to make its body bigger."},{"games":["Sword"],"text":"Grudges of the dead have possessed a mound of sand and become a Pokémon. Sandygast is fond of the shovel on its head."},{"games":["Ultra Moon"],"text":"If you build sand mounds when you’re playing, destroy them before you go home, or they may get possessed and become Sandygast."},{"games":["Ultra Sun"],"text":"It likes the shovel on its head, so Sandygast will get serious and fight any children who come to take it back."},{"games":["Moon"],"text":"It takes control of anyone who puts a hand in its mouth. And so it adds to the accumulation of its sand-mound body."},{"games":["Sun"],"text":"Born from a sand mound playfully built by a child, this Pokémon embodies the grudges of the departed."}],"abilities":[{"name":"Water Compaction","hidden":false,"description":"Boosts the Defense stat sharply when the Pokémon is hit by a Water-type move."},{"name":"Sand Veil","hidden":true,"description":"Boosts the Pokémon's evasiveness in a sandstorm."}],"eggGroups":["Amorphous"],"genderRate":4,"hatchCounter":15,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Brown","shape":"Squiggle","evolution":{"id":769,"name":"Sandygast","condition":null,"children":[{"id":770,"name":"Palossand","condition":"Lv. 42","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[1,71],[1,106],[5,310],[10,328],[15,72],[20,28],[25,523],[30,95],[35,202],[40,334],[45,247],[50,414],[55,659],[60,201]],"machine":[133,523,886,109,174,414,89,203,412,263,430,374,202,356,506,286,334,341,189,101,220,809,182,94,240,156,157,317,328,201,184,815,247,285,214,188,180,446,444,164,241,851,271],"egg":[246,174,194,255,254,256],"tutor":[]},"cards":[{"id":"sv2-214","name":"Sandygast","set":"Paldea Evolved","date":"2023-06-09","rarity":"Illustration Rare","number":"214","artist":"Teeziro","img":"sv