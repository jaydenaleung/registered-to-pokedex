{"id":736,"flavor":[{"games":["Shield"],"text":"It uses its big jaws to dig nests into the forest floor, and it loves to feed on sweet tree sap."},{"games":["Sword"],"text":"Its natural enemies, like Rookidee, may flee rather than risk getting caught in its large mandibles that can snap thick tree branches."},{"games":["Ultra Moon"],"text":"It spits a sticky thread to stop opponents in their tracks, and then it grabs them in its sharp, sturdy mandibles to take them down."},{"games":["Ultra Sun"],"text":"If you find its nest, you shouldn’t stick your hand inside. You’ll get bitten by an irritated Grubbin."},{"games":["Moon"],"text":"They often gather near places frequented by electric Pokémon in order to avoid being attacked by bird Pokémon."},{"games":["Sun"],"text":"Its strong jaw enables it to scrape trees and slurp out the sap. It normally lives underground."}],"abilities":[{"name":"Swarm","hidden":false,"description":"Powers up Bug-type moves when the Pokémon's HP is low."}],"eggGroups":["Bug"],"genderRate":4,"hatchCounter":15,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Gray","shape":"Armor","evolution":{"id":736,"name":"Grubbin","condition":null,"children":[{"id":737,"name":"Charjabug","condition":"Lv. 20","children":[{"id":738,"name":"Vikavolt","condition":"Level up at Vast Poni Canyon (or 1 other place) or Use Thunder Stone","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[1,11],[1,189],[5,81],[10,450],[15,44],[21,209],[25,564],[30,404],[35,242],[40,91]],"machine":[226,450,268,451,242,91,604,527,203,263,113,679,341,189,398,884,182,240,156,806,214,522,164,36,851,86,85,521,528,404],"egg":[435,106],"tutor":[]},"cards":[{"id":"me5-2","name":"Grubbin","set":"Pitch Black","date":"2026-07-17","rarity":"Common","number":"2","artist":"Mina Nakai","small":"https://images.scrydex.com/pokemon/me5-2/small","large":"https://images.scrydex.com/pokemon/me5-2/large"},{"id":"me2pt5-17","name":"Grubbin","set":"Ascended Heroes","date":"2026-01