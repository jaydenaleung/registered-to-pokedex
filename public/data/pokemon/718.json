{"id":718,"flavor":[{"games":["Ultra Moon"],"text":"Some say it can change to an even more powerful form when battling those who threaten the ecosystem."},{"games":["Ultra Sun"],"text":"This is Zygarde’s form when about half of its pieces have been assembled. It plays the role of monitoring the ecosystem."},{"games":["Moon"],"text":"It’s thought to be monitoring the ecosystem. There are rumors that even greater power lies hidden within it."},{"games":["Sun"],"text":"This is Zygarde’s form when it has gathered 50% of its cells. It wipes out all those who oppose it, showing not a shred of mercy."},{"games":["Alpha Sapphire","Y"],"text":"It’s hypothesized that it’s monitoring those who destroy the ecosystem from deep in the cave where it lives."},{"games":["Omega Ruby","X"],"text":"When the Kalos region’s ecosystem falls into disarray, it appears and reveals its secret power."}],"abilities":[{"name":"Aura Break","hidden":false,"description":"The effects of “Aura” Abilities are reversed to lower the power of affected moves."}],"eggGroups":["Undiscovered"],"genderRate":-1,"hatchCounter":120,"baseHappiness":0,"growthRate":"slow","habitat":null,"color":"Green","shape":"Squiggle","evolution":{"id":718,"name":"Zygarde","condition":null,"children":[]},"moves":{"game":"Sword / Shield","level":[[1,20],[1,44],[1,225],[1,523],[1,614],[1,615],[1,687],[8,114],[16,91],[24,219],[32,242],[40,406],[48,616],[56,137],[64,201],[72,489],[80,89],[88,200]],"machine":[34,784,280,523,242,91,349,406,414,89,203,263,411,416,447,667,63,304,231,200,371,182,156,514,179,157,496,219,201,214,482,173,707,444,164,241,276,129,428],"egg":[],"tutor":[434,799,815,806]},"cards":[{"id":"me3-120","name":"Mega Zygarde ex","set":"Perfect Order","date":"2026-03-27","rarity":"Special Illustration Rare","number":"120","artist":null,"small":"https://images.scrydex.com/pokemon/me3-120/small","large":"https://images.scrydex.com/pokemon/me3-120/large"},{"id":"me3-47","name":"Mega Zygarde ex","set":"Perfect Order","date"