{"id":468,"flavor":[{"games":["Legends: Arceus"],"text":"Scant few have ever sighted this Pokémon. After studying what literature remains, I am certain Togekiss will reveal itself when peace reigns in the land."},{"games":["Shield"],"text":"Known as a bringer of blessings, it’s been depicted on good-luck charms since ancient times."},{"games":["Sword"],"text":"These Pokémon are never seen anywhere near conflict or turmoil. In recent times, they’ve hardly been seen at all."},{"games":["Alpha Sapphire","Y","White 2","Black 2","White","Black","Platinum"],"text":"It shares many blessings with people who respect one another’s rights and avoid needless strife."},{"games":["Omega Ruby","X","SoulSilver","HeartGold"],"text":"As everyone knows, it visits peaceful regions, bringing them gifts of kindness and sweet blessings."},{"games":["Pearl","Diamond"],"text":"It will never appear where there is strife. Its sightings have become rare recently."}],"abilities":[{"name":"Hustle","hidden":false,"description":"Boosts the Pokémon's Attack stat but lowers its accuracy."},{"name":"Serene Grace","hidden":false,"description":"Raises the likelihood of additional effects occurring when the Pokémon uses its moves."},{"name":"Super Luck","hidden":true,"description":"The Pokémon is so lucky that the critical-hit ratios of its moves are boosted."}],"eggGroups":["Flying","Fairy"],"genderRate":1,"hatchCounter":10,"baseHappiness":70,"growthRate":"fast","habitat":null,"color":"White","shape":"Wings","evolution":{"id":175,"name":"Togepi","condition":null,"children":[{"id":176,"name":"Togetic","condition":"Level up, High Friendship","children":[{"id":468,"name":"Togekiss","condition":"Use Shiny Stone","children":[]}]}]},"moves":{"game":"Sword / Shield","level":[[0,403],[1,1],[1,38],[1,45],[1,118],[1,143],[1,161],[1,186],[1,204],[1,219],[1,226],[1,245],[1,246],[1,266],[1,273],[1,281],[1,387],[1,396],[1,495],[1,584],[1,791]],"machine":[403,502,133,213,396,226,34,280,204,605,409,577,227,203,263,126