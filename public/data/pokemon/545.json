{"id":545,"flavor":[{"games":["Shield"],"text":"Scolipede engage in fierce territorial battles with Centiskorch. At the end of one of these battles, the victor makes a meal of the loser."},{"games":["Sword"],"text":"Scolipede latches on to its prey with the claws on its neck before slamming them into the ground and jabbing them with its claws’ toxic spikes."},{"games":["Alpha Sapphire","Y","Black"],"text":"With quick movements, it chases down its foes, attacking relentlessly with its horns until it prevails."},{"games":["Omega Ruby","X","White 2","Black 2"],"text":"It clasps its prey with the claws on its neck until it stops moving. Then it finishes it off with deadly poison."},{"games":["White"],"text":"Highly aggressive, it uses the claws near its neck to dig into its opponents and poison them."}],"abilities":[{"name":"Poison Point","hidden":false,"description":"Contact with the Pokémon may poison the attacker."},{"name":"Swarm","hidden":false,"description":"Powers up Bug-type moves when the Pokémon's HP is low."},{"name":"Speed Boost","hidden":true,"description":"The Pokémon's Speed stat is boosted every turn."}],"eggGroups":["Bug"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Red","shape":"Armor","evolution":{"id":543,"name":"Venipede","condition":null,"children":[{"id":544,"name":"Whirlipede","condition":"Lv. 22","children":[{"id":545,"name":"Scolipede","condition":"Lv. 30","children":[]}]}]},"moves":{"game":"Sword / Shield","level":[[1,40],[1,111],[1,182],[1,205],[1,226],[1,334],[12,342],[16,103],[20,450],[26,474],[34,36],[42,97],[50,92],[58,599],[66,38],[74,224]],"machine":[97,372,213,226,523,440,91,89,203,263,416,360,506,63,334,231,224,371,42,398,182,156,157,317,496,103,214,188,684,173,76,191,707,164,241,276,14,675,390,599,474,404],"egg":[],"tutor":[806,798]},"cards":[{"id":"zsv10pt5-134","name":"Scolipede","set":"Black Bolt","date":"2025-07-18","rarity":"Illustration Rare","number":"134","artist":"Ok