{"id":482,"flavor":[{"games":["Legends: Arceus"],"text":"The dreaded Being of Willpower. Legends tell of this Pokémon manipulating the will of its adversaries and turning them into puppets of its own."},{"games":["Alpha Sapphire","Y","Pearl"],"text":"It is thought that Uxie, Mesprit, and Azelf all came from the same egg."},{"games":["Omega Ruby","X","Diamond"],"text":"Known as “The Being of Willpower.” It sleeps at the bottom of a lake to keep the world in balance."},{"games":["White 2","Black 2","White","Black","Platinum"],"text":"When Azelf flew, people gained the determination to do things. It was the birth of willpower."},{"games":["SoulSilver","HeartGold"],"text":"This Pokémon is said to have endowed humans with the determination needed to face any of life’s difficulties."}],"abilities":[{"name":"Levitate","hidden":false,"description":"By floating in the air, the Pokémon receives full immunity to all Ground-type moves."}],"eggGroups":["Undiscovered"],"genderRate":-1,"hatchCounter":80,"baseHappiness":140,"growthRate":"slow","habitat":null,"color":"Blue","shape":"Upright","evolution":{"id":482,"name":"Azelf","condition":null,"children":[]},"moves":{"game":"Scarlet / Violet","level":[[1,93],[1,156],[7,129],[14,197],[21,60],[28,286],[35,326],[42,417],[49,94],[56,253],[63,248],[70,387],[77,153],[84,832]],"machine":[512,226,347,451,605,38,409,577,227,283,203,412,797,263,126,7,53,374,248,416,447,270,63,8,286,282,113,118,189,417,583,182,60,244,94,473,240,115,156,201,247,285,214,446,500,164,241,129,269,851,87,9,86,85,271,433,369,253,352,428],"egg":[],"tutor":[]},"cards":[{"id":"sv8-80","name":"Azelf","set":"Surging Sparks","date":"2024-11-08","rarity":"Common","number":"80","artist":null,"img":"sv8/80"},{"id":"swsh10-67","name":"Azelf","set":"Astral Radiance","date":"2022-05-27","rarity":"Uncommon","number":"67","artist":"Taira Akitsu","img":"swsh10/67"},{"id":"sm11-85","name":"Azelf","set":"Unified Minds","date":"2019-08-02","rarity":"Uncommon","number":"85","artist":"