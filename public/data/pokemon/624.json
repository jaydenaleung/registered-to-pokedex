{"id":624,"flavor":[{"games":["Shield"],"text":"A pack of these Pokémon forms to serve a Bisharp boss. Each Pawniard trains diligently, dreaming of one day taking the lead."},{"games":["Sword"],"text":"It uses river stones to maintain the cutting edges of the blades covering its body. These sharpened blades allow it to bring down opponents."},{"games":["Ultra Moon"],"text":"It follows Bisharp’s orders to a tee when it attacks enemies. After slashing an opponent, Pawniard clangs both of its blades together."},{"games":["Ultra Sun"],"text":"After shredding its prey, it sharpens its blades on a stone by the river. Each Pawniard has its own favorite sharpening stone."},{"games":["Alpha Sapphire","Y","White 2","Black 2"],"text":"Ignoring their injuries, groups attack by sinking the blades that cover their bodies into their prey."},{"games":["Omega Ruby","X","Black"],"text":"Blades comprise this Pokémon’s entire body. If battling dulls the blades, it sharpens them on stones by the river."},{"games":["White"],"text":"They fight at Bisharp’s command. They cling to their prey and inflict damage by sinking their blades into it."}],"abilities":[{"name":"Defiant","hidden":false,"description":"If the Pokémon has any stat lowered by an opposing Pokémon, its Attack stat will be boosted sharply."},{"name":"Inner Focus","hidden":false,"description":"The Pokémon's intense focus prevents it from flinching or being affected by Intimidate."},{"name":"Pressure","hidden":true,"description":"Puts other Pokémon under pressure, causing them to expend more PP to use their moves."}],"eggGroups":["Human-Like"],"genderRate":4,"hatchCounter":20,"baseHappiness":35,"growthRate":"medium","habitat":null,"color":"Red","shape":"Humanoid","evolution":{"id":624,"name":"Pawniard","condition":null,"children":[{"id":625,"name":"Bisharp","condition":"Lv. 52","children":[{"id":983,"name":"Kingambit","condition":"Defeat 3 Bisharp that lead Pawniard","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level"