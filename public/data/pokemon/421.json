{"id":421,"flavor":[{"games":["Legends: Arceus"],"text":"Motionless, save for the occasional quiver. A rich array of Pokémon can be found gathered around it, drawn by the scent exuded from Cherrim's folded petals."},{"games":["Shield"],"text":"Its folded petals are pretty tough. Bird Pokémon can peck at them all they want, and Cherrim won’t be bothered at all."},{"games":["Sword"],"text":"As a bud, it barely moves. It sits still, placidly waiting for sunlight to appear."},{"games":["Alpha Sapphire","Y","White 2","Black 2","White","Black","Platinum"],"text":"If it senses strong sunlight, it opens its folded petals to absorb the sun’s rays with its whole body."},{"games":["Omega Ruby","X","SoulSilver","HeartGold"],"text":"During times of strong sunlight, its bud blooms, its petals open fully, and it becomes very active."},{"games":["Pearl"],"text":"It is docile as a bud, but turns cheerful when it blooms. It folds back into a bud if sunlight wanes."},{"games":["Diamond"],"text":"It blooms during times of strong sunlight. It tries to make up for everything it endured as a bud."}],"abilities":[{"name":"Flower Gift","hidden":false,"description":"Boosts the Attack and Sp. Def stats of itself and allies in harsh sunlight."}],"eggGroups":["Fairy","Grass"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Purple","shape":"Legs","evolution":{"id":420,"name":"Cherubi","condition":null,"children":[{"id":421,"name":"Cherrim","condition":"Lv. 25","children":[]}]},"moves":{"game":"Sword / Shield","level":[[0,241],[1,33],[1,74],[1,234],[1,579],[1,670],[15,270],[20,345],[28,73],[34,36],[41,572],[48,388],[55,76],[62,80]],"machine":[213,331,605,577,203,412,263,202,416,447,580,270,63,345,583,676,182,156,496,219,402,214,173,76,669,164,241,14,311],"egg":[],"tutor":[803]},"cards":[{"id":"me55-7","name":"Cherrim","set":"30th Celebration","date":"2026-09-16","rarity":"Common","number":"7","artist":"takashi shiraishi","small":"https://images.sc