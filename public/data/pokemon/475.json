{"id":475,"flavor":[{"games":["Legends: Arceus"],"text":"The blades extending from its elbows are sharper than the finest swords. Its swordsmanship, albeit self-taught, is astonishingly impressive."},{"games":["Shield"],"text":"Sharply attuned to others’ wishes for help, this Pokémon seeks out those in need and aids them in battle."},{"games":["Sword"],"text":"True to its honorable-warrior image, it uses the blades on its elbows only in defense of something or someone."},{"games":["Alpha Sapphire","Y","Pearl","Diamond"],"text":"A master of courtesy and swordsmanship, it fights using extending swords on its elbows."},{"games":["Omega Ruby","X","SoulSilver","HeartGold"],"text":"Because it can sense what its foe is thinking, its attacks burst out first, fast, and fierce."},{"games":["White 2","Black 2","White","Black","Platinum"],"text":"When trying to protect someone, it extends its elbows as if they were swords and fights savagely."}],"abilities":[{"name":"Steadfast","hidden":false,"description":"The Pokémon's determination boosts its Speed stat every time it flinches."},{"name":"Sharpness","hidden":false,"description":"Powers up slicing moves."},{"name":"Justified","hidden":true,"description":"When the Pokémon is hit by a Dark-type attack, its Attack stat is boosted by its sense of justice."}],"eggGroups":["Human-Like","Amorphous"],"genderRate":0,"hatchCounter":20,"baseHappiness":35,"growthRate":"slow","habitat":null,"color":"White","shape":"Humanoid","evolution":{"id":280,"name":"Ralts","condition":null,"children":[{"id":281,"name":"Kirlia","condition":"Lv. 20","children":[{"id":282,"name":"Gardevoir","condition":"Lv. 30","children":[]},{"id":475,"name":"Gallade","condition":"Use Dawn Stone (male)","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[0,163],[1,43],[1,45],[1,60],[1,93],[1,94],[1,95],[1,104],[1,138],[1,204],[1,210],[1,248],[1,286],[1,347],[1,348],[1,400],[1,533],[1,574],[1,577],[1,791],[1,895],[9,270],[12,364],[15,100],[18,332],[23,206],[2