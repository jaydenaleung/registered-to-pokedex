{"id":578,"flavor":[{"games":["Shield"],"text":"Its brain has split into two, and the two halves rarely think alike. Its actions are utterly unpredictable."},{"games":["Sword"],"text":"Its psychic power can supposedly cover a range of more than half a mile—but only if its two brains can agree with each other."},{"games":["Alpha Sapphire","Y","White 2","Black 2"],"text":"When their two divided brains think the same thoughts, their psychic power is maximized."},{"games":["Omega Ruby","X","Black"],"text":"Since they have two divided brains, at times they suddenly try to take two different actions at once."},{"games":["White"],"text":"When their brains, now divided in two, are thinking the same thoughts, these Pokémon exhibit their maximum power."}],"abilities":[{"name":"Overcoat","hidden":false,"description":"The Pokémon takes no damage from sandstorms. It is also protected from the effects of powders and spores."},{"name":"Magic Guard","hidden":false,"description":"The Pokémon only takes damage from attacks."},{"name":"Regenerator","hidden":true,"description":"The Pokémon has a little of its HP restored when withdrawn from battle."}],"eggGroups":["Amorphous"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Green","shape":"Ball","evolution":{"id":577,"name":"Solosis","condition":null,"children":[{"id":578,"name":"Duosion","condition":"Lv. 32","children":[{"id":579,"name":"Reuniclus","condition":"Lv. 41","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[1,93],[1,105],[1,182],[1,283],[12,60],[16,204],[20,473],[24,113],[24,115],[28,502],[35,220],[40,94],[46,285],[52,248],[58,472]],"machine":[347,204,109,227,283,203,412,797,263,430,248,356,360,270,286,334,113,101,220,182,60,244,94,678,473,240,115,156,157,317,247,285,214,500,164,241,129,851,87,86,271,433,428],"egg":[151,310,109],"tutor":[]},"cards":[{"id":"zsv10pt5-119","name":"Duosion","set":"Black Bolt","date":"2025-07-18","rarity":"Illustration Rare","n