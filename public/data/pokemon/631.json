{"id":631,"flavor":[{"games":["Shield"],"text":"A flame serves as its tongue, melting through the hard shell of Durant so that Heatmor can devour their insides."},{"games":["Sword"],"text":"There’s a hole in its tail that allows it to draw in the air it needs to keep its fire burning. If the hole gets blocked, this Pokémon will fall ill."},{"games":["Alpha Sapphire","Y","White 2","Black 2"],"text":"It draws in air through its tail, transforms it into fire, and uses it like a tongue. It melts Durant and eats them."},{"games":["Omega Ruby","X","White"],"text":"Using their very hot, flame-covered tongues, they burn through Durant’s steel bodies and consume their insides."},{"games":["Black"],"text":"It breathes through a hole in its tail while it burns with an internal fire. Durant is its prey."}],"abilities":[{"name":"Gluttony","hidden":false,"description":"If the Pokémon is holding a Berry to be eaten when its HP is low, it will instead eat the Berry when its HP drops to half or less."},{"name":"Flash Fire","hidden":false,"description":"If hit by a Fire-type move, the Pokémon absorbs the flames and uses them to power up its own Fire-type moves."},{"name":"White Smoke","hidden":true,"description":"The Pokémon is protected by its white smoke, which prevents other Pokémon from lowering its stats."}],"eggGroups":["Field"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Red","shape":"Upright","evolution":{"id":631,"name":"Heatmor","condition":null,"children":[]},"moves":{"game":"Sword / Shield","level":[[1,33],[1,122],[5,154],[10,510],[15,450],[20,254],[20,255],[20,256],[25,163],[30,20],[35,680],[40,468],[45,133],[50,83],[55,517],[60,394]],"machine":[133,213,34,693,91,409,203,263,126,7,83,53,394,374,411,202,416,257,67,315,182,240,156,317,496,421,214,173,76,707,164,241,276,269,168,675,9,261],"egg":[562,174,400,389,321],"tutor":[807,815]},"cards":[{"id":"rsv10pt5-104","name":"Heatmor","set":"White Flare","date":"2025-07-18",