{"id":536,"flavor":[{"games":["Shield"],"text":"On occasion, their cries are sublimely pleasing to the ear. Palpitoad with larger lumps on their bodies can sing with a wider range of sounds."},{"games":["Sword"],"text":"It weakens its prey with sound waves intense enough to cause headaches, then entangles them with its sticky tongue."},{"games":["Alpha Sapphire","Y","White 2","Black 2"],"text":"It lives in the water and on land. It uses its long, sticky tongue to immobilize its opponents."},{"games":["Omega Ruby","X","Black"],"text":"When they vibrate the bumps on their heads, they can make waves in water or earthquake-like vibrations on land."},{"games":["White"],"text":"It lives in the water and on land. It uses its long, sticky tongue to capture prey."}],"abilities":[{"name":"Swift Swim","hidden":false,"description":"Boosts the Pokémon's Speed stat in rain."},{"name":"Hydration","hidden":false,"description":"Cures the Pokémon's status conditions in rain."},{"name":"Water Absorb","hidden":true,"description":"If hit by a Water-type move, the Pokémon has its HP restored instead of taking damage."}],"eggGroups":["Water 1"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Blue","shape":"Upright","evolution":{"id":535,"name":"Tympole","condition":null,"children":[{"id":536,"name":"Palpitoad","condition":"Lv. 25","children":[{"id":537,"name":"Seismitoad","condition":"Lv. 36","children":[]}]}]},"moves":{"game":"Sword / Shield","level":[[1,45],[1,48],[1,51],[1,497],[12,341],[16,496],[20,61],[24,175],[30,253],[37,392],[42,304],[48,330],[54,240],[60,56]],"machine":[213,340,523,414,203,263,258,56,304,196,341,330,438,182,240,156,496,503,103,214,188,482,173,446,164,57,253,599,311],"egg":[],"tutor":[]},"cards":[{"id":"zsv10pt5-104","name":"Palpitoad","set":"Black Bolt","date":"2025-07-18","rarity":"Illustration Rare","number":"104","artist":"KEIICHIRO ITO","img":"zsv10pt5/104"},{"id":"zsv10pt5-20","name":"Palpitoad","set":"B