{"id":510,"flavor":[{"games":["Shield"],"text":"This stealthy Pokémon sneaks up behind prey without making any sound at all. It competes with Thievul for territory."},{"games":["Sword"],"text":"Don’t be fooled by its gorgeous fur and elegant figure. This is a moody and vicious Pokémon."},{"games":["Alpha Sapphire","Y","White"],"text":"Stealthily, it sneaks up on its target, striking from behind before its victim has a chance to react."},{"games":["Omega Ruby","X","White 2","Black 2"],"text":"Their beautiful form comes from the muscles they have developed. They run silently in the night."},{"games":["Black"],"text":"These Pokémon vanish and appear unexpectedly. Many Trainers are drawn to their beautiful form and fur."}],"abilities":[{"name":"Limber","hidden":false,"description":"The Pokémon's limber body prevents it from being paralyzed."},{"name":"Unburden","hidden":false,"description":"Boosts the Speed stat if the Pokémon's held item is used or lost."},{"name":"Prankster","hidden":true,"description":"Gives priority to the Pokémon's status moves."}],"eggGroups":["Field"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Purple","shape":"Quadruped","evolution":{"id":509,"name":"Purrloin","condition":null,"children":[{"id":510,"name":"Liepard","condition":"Lv. 20","children":[]}]},"moves":{"game":"Sword / Shield","level":[[1,10],[1,28],[1,45],[1,252],[12,154],[16,259],[23,372],[28,468],[34,389],[40,417],[46,400],[52,583]],"machine":[372,213,226,204,399,227,203,263,313,492,416,447,441,63,304,231,417,6,371,583,182,427,240,156,496,103,402,247,421,214,555,173,164,241,129,269,168,675,86,271,369],"egg":[],"tutor":[807,808,806]},"cards":[{"id":"rsv10pt5-137","name":"Liepard","set":"White Flare","date":"2025-07-18","rarity":"Illustration Rare","number":"137","artist":"matazo","img":"rsv10pt5/137"},{"id":"rsv10pt5-56","name":"Liepard","set":"White Flare","date":"2025-07-18","rarity":"Uncommon","number":"56","artist":"Yuu Nishida"