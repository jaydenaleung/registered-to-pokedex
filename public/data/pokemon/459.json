{"id":459,"flavor":[{"games":["Legends: Arceus"],"text":"One is likely to encounter this Pokémon while out in the snow. There are stories of Snover appearing in human settlements but doing no harm—rather, they bond with the children."},{"games":["Shield"],"text":"The berries that grow around its belly are like ice pops. Galarian Darumaka absolutely love these berries."},{"games":["Sword"],"text":"It lives on snowy mountains. It sinks its legs into the snow to absorb water and keep its own temperature down."},{"games":["Alpha Sapphire","Y","Pearl"],"text":"In the spring, it grows berries with the texture of frozen treats around its belly."},{"games":["Omega Ruby","X","SoulSilver","HeartGold"],"text":"During cold seasons, it migrates to the mountain’s lower reaches. It returns to the snow-covered summit in the spring."},{"games":["White 2","Black 2","White","Black","Platinum"],"text":"Seemingly curious about people, they gather around footsteps they find on snowy mountains."},{"games":["Diamond"],"text":"It lives on snowy mountains. Having had little contact with humans, it is boldly inquisitive."}],"abilities":[{"name":"Snow Warning","hidden":false,"description":"The Pokémon makes it snow when it enters a battle."},{"name":"Soundproof","hidden":true,"description":"Soundproofing gives the Pokémon full immunity to all sound-based moves."}],"eggGroups":["Monster","Grass"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"slow","habitat":null,"color":"White","shape":"Upright","evolution":{"id":459,"name":"Snover","condition":null,"children":[{"id":460,"name":"Abomasnow","condition":"Lv. 40","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[1,43],[1,181],[5,670],[10,54],[15,420],[20,75],[25,196],[30,207],[35,275],[41,452],[45,59],[50,329]],"machine":[419,59,34,331,886,174,38,203,412,263,202,447,803,270,58,8,861,333,196,437,345,189,182,240,156,402,214,883,76,164,14,36,851,885,352,311],"egg":[38,74,73,23,311],"tutor":[]},"cards":[{"id":"me1-140",