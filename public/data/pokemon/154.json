{"id":154,"flavor":[{"games":["Alpha Sapphire","Omega Ruby","Sapphire","Ruby"],"text":"The fragrance of Meganium’s flower soothes and calms emotions. In battle, this Pokémon gives off more of its becalming scent to blunt the foe’s fighting spirit."},{"games":["Y","SoulSilver","FireRed","Silver"],"text":"Meganium’s breath has the power to revive dead grass and plants. It can make them healthy again."},{"games":["X","HeartGold","LeafGreen","Gold"],"text":"The aroma that rises from its petals contains a substance that calms aggressive feelings."},{"games":["White 2","Black 2","White","Black","Platinum","Pearl","Diamond"],"text":"Its breath has the fantastic ability to revive dead plants and flowers."},{"games":["Emerald"],"text":"The fragrance of a MEGANIUM’s flower soothes and calms emotions. In battle, it gives off more of its becalming scent to blunt the foe’s fighting spirit."},{"games":["Crystal"],"text":"Anyone who stands beside it becomes refreshed, just as if they were relaxing in a sunny forest."}],"abilities":[{"name":"Overgrow","hidden":false,"description":"Powers up Grass-type moves when the Pokémon's HP is low."},{"name":"Leaf Guard","hidden":true,"description":"Prevents status conditions in harsh sunlight."}],"eggGroups":["Monster","Grass"],"genderRate":1,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium slow","habitat":"grassland","color":"Green","shape":"Quadruped","evolution":{"id":152,"name":"Chikorita","condition":null,"children":[{"id":153,"name":"Bayleef","condition":"Lv. 16","children":[{"id":154,"name":"Meganium","condition":"Lv. 32","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[0,80],[1,33],[1,45],[1,75],[1,77],[1,572],[12,235],[18,115],[22,345],[26,73],[34,230],[40,113],[46,34],[54,219],[60,202],[65,76]],"machine":[776,34,523,331,204,174,38,525,89,227,283,203,412,263,313,338,202,416,447,520,803,580,270,63,282,437,113,345,189,200,572,182,115,156,402,214,76,669,707,164,241,14,36,851,885,311,428],"egg":[246,68,175,505,275