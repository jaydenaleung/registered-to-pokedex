{"id":738,"flavor":[{"games":["Shield"],"text":"If it carries a Charjabug to use as a spare battery, a flying Vikavolt can rapidly fire high-powered beams of electricity."},{"games":["Sword"],"text":"It builds up electricity in its abdomen, focuses it through its jaws, and then fires the electricity off in concentrated beams."},{"games":["Ultra Moon"],"text":"Vikavolt flusters opponents with acrobatic flying maneuvers. This creates an opening for it to deliver an electric beam attack."},{"games":["Ultra Sun"],"text":"It has an organ that generates electricity in its abdomen. It concentrates energy in its strong jaws and fires off powerful jolts of electricity."},{"games":["Moon"],"text":"It produces electricity via an electrical organ in its abdomen. It overwhelms bird Pokémon with shocking beams of electrical energy."},{"games":["Sun"],"text":"It zips around, on sharp lookout for an opening. It concentrates electrical energy within its large jaws and uses it to zap its enemies."}],"abilities":[{"name":"Levitate","hidden":false,"description":"By floating in the air, the Pokémon receives full immunity to all Ground-type moves."}],"eggGroups":["Bug"],"genderRate":4,"hatchCounter":15,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Blue","shape":"Armor","evolution":{"id":736,"name":"Grubbin","condition":null,"children":[{"id":737,"name":"Charjabug","condition":"Lv. 20","children":[{"id":738,"name":"Vikavolt","condition":"Level up at Vast Poni Canyon (or 1 other place) or Use Thunder Stone","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[0,85],[1,81],[1,242],[1,268],[1,435],[15,44],[23,209],[29,564],[36,405],[43,12],[50,19],[57,97],[64,192]],"machine":[512,97,403,226,450,405,523,268,451,242,91,598,604,486,527,203,412,263,430,19,416,63,334,113,679,341,189,398,884,182,240,156,806,214,76,522,164,916,129,36,851,87,86,85,521,528,404],"egg":[450,91,435,106,334,189,11,404],"tutor":[]},"cards":[{"id":"me2pt5-230","name":"Vikavolt","set":"Ascended