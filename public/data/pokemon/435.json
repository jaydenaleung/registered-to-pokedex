{"id":435,"flavor":[{"games":["Legends: Arceus"],"text":"Sprays a poisonous fluid to take down prey. Sometimes, unable to stomach the stench of its own fluid, it leaves the bested prey uneaten."},{"games":["Shield"],"text":"It digs holes in the ground to make its nest. The stench of the fluid it lets fly from the tip of its tail is extremely potent."},{"games":["Sword"],"text":"In its belly, it reserves stinky fluid that it shoots from its tail during battle. As this Pokémon’s diet varies, so does the stench of its fluid."},{"games":["Alpha Sapphire","Y","Pearl"],"text":"It sprays a stinky fluid from its tail. The fluid smells worse the longer it is allowed to fester."},{"games":["Omega Ruby","X","Diamond"],"text":"It sprays a vile-smelling fluid from the tip of its tail to attack. Its range is over 160 feet."},{"games":["White 2","Black 2","White","Black","Platinum"],"text":"It attacks by spraying a horribly smelly fluid from the tip of its tail. Attacks from above confound it."},{"games":["SoulSilver","HeartGold"],"text":"It attacks by spraying a repugnant fluid from its tail, but the stench dulls after a few squirts."}],"abilities":[{"name":"Stench","hidden":false,"description":"By releasing a stench when attacking, the Pokémon may cause the target to flinch."},{"name":"Aftermath","hidden":false,"description":"Damages the attacker if it knocks out the Pokémon with a move that makes direct contact."},{"name":"Keen Eye","hidden":true,"description":"The Pokémon's keen eyes prevent its accuracy from being lowered."}],"eggGroups":["Field"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"medium","habitat":null,"color":"Purple","shape":"Quadruped","evolution":{"id":434,"name":"Stunky","condition":null,"children":[{"id":435,"name":"Skuntank","condition":"Lv. 34","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[0,53],[1,10],[1,108],[1,139],[1,364],[12,154],[15,116],[18,44],[21,474],[24,103],[27,92],[30,389],[33,262],[38,400],[43,562],[48,153