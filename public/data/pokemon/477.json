{"id":477,"flavor":[{"games":["Legends: Arceus"],"text":"Comes to those whose lives have come to an end and escorts their souls to the afterlife. Known to mistakenly take the souls of those who yet have life left in them, albeit rarely."},{"games":["Shield"],"text":"With the mouth on its belly, Dusknoir swallows its target whole. The soul is the only thing eaten— Dusknoir disgorges the body before departing."},{"games":["Sword"],"text":"At the bidding of transmissions from the spirit world, it steals people and Pokémon away. No one knows whether it has a will of its own."},{"games":["Alpha Sapphire","Y","Pearl","Diamond"],"text":"The antenna on its head captures radio waves from the world of spirits that command it to take people there."},{"games":["Omega Ruby","X","White 2","Black 2","White","Black","Platinum"],"text":"It is said to take lost spirits into its pliant body and guide them home."},{"games":["SoulSilver","HeartGold"],"text":"This feared Pokémon is said to travel to worlds unknown. Some even believe that it takes lost spirits along with it."}],"abilities":[{"name":"Pressure","hidden":false,"description":"Puts other Pokémon under pressure, causing them to expend more PP to use their moves."},{"name":"Frisk","hidden":true,"description":"When it enters a battle, the Pokémon can check an opposing Pokémon's held item."}],"eggGroups":["Amorphous"],"genderRate":4,"hatchCounter":25,"baseHappiness":35,"growthRate":"fast","habitat":null,"color":"Black","shape":"Arms","evolution":{"id":355,"name":"Duskull","condition":null,"children":[{"id":356,"name":"Dusclops","condition":"Lv. 37","children":[{"id":477,"name":"Dusknoir","condition":"Trade, holding Reaper Cloth","children":[]}]}]},"moves":{"game":"Scarlet / Violet","level":[[1,7],[1,8],[1,9],[1,20],[1,43],[1,50],[1,310],[1,325],[1,356],[1,425],[12,109],[16,101],[20,371],[24,261],[28,212],[32,506],[36,174],[42,247],[48,248],[54,194]],"machine":[59,34,280,347,451,109,174,399,89,203,263,7,374,411,264,248,416,356,912,