{"id":620,"flavor":[{"games":["Shield"],"text":"Delivered at blinding speeds, kicks from this Pokémon can shatter massive boulders into tiny pieces."},{"games":["Sword"],"text":"When Mienshao comes across a truly challenging opponent, it will lighten itself by biting off the fur on its arms."},{"games":["Ultra Moon"],"text":"When Mienshao lets out a bizarre wail, you’re in danger. A flurry of kicks and chops too fast to see is about to be unleashed!"},{"games":["Ultra Sun"],"text":"It overwhelms its opponents with continuous attacks and then slowly stores up power before delivering the finishing blow."},{"games":["Alpha Sapphire","Y","White 2","Black 2"],"text":"Using the long fur on its arms like whips, it launches into combo attacks that, once started, no one can stop."},{"games":["Omega Ruby","X","Black"],"text":"It wields the fur on its arms like a whip. Its arm attacks come with such rapidity that they cannot even be seen."},{"games":["White"],"text":"They use the long fur on their arms as a whip to strike their opponents."}],"abilities":[{"name":"Inner Focus","hidden":false,"description":"The Pokémon's intense focus prevents it from flinching or being affected by Intimidate."},{"name":"Regenerator","hidden":false,"description":"The Pokémon has a little of its HP restored when withdrawn from battle."},{"name":"Reckless","hidden":true,"description":"Powers up moves that have recoil damage."}],"eggGroups":["Field","Human-Like"],"genderRate":4,"hatchCounter":25,"baseHappiness":70,"growthRate":"medium slow","habitat":null,"color":"Purple","shape":"Upright","evolution":{"id":619,"name":"Mienfoo","condition":null,"children":[{"id":620,"name":"Mienshao","condition":"Lv. 50","children":[]}]},"moves":{"game":"Scarlet / Violet","level":[[1,1],[1,179],[1,197],[1,252],[1,501],[15,154],[20,469],[25,395],[30,369],[35,409],[40,468],[45,396],[53,340],[59,347],[66,136]],"machine":[512,332,97,396,226,280,339,347,370,811,91,38,409,203,263,374,411,264,416,447,270,63,861,282,67,490