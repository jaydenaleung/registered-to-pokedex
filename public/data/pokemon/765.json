{"id":765,"flavor":[{"games":["Shield"],"text":"It knows the forest inside and out. If it comes across a wounded Pokémon, Oranguru will gather medicinal herbs to treat it."},{"games":["Sword"],"text":"With waves of its fan—made from leaves and its own fur—Oranguru skillfully gives instructions to other Pokémon."},{"games":["Ultra Moon"],"text":"Oranguru don’t get along with each other, so they’re always engaging in battles of wits to decide which one is superior."},{"games":["Ultra Sun"],"text":"It normally spends its time meditating in the treetops. It throws Poké Balls and gives other Pokémon orders as it pleases."},{"games":["Moon"],"text":"Deep in the jungle, high in the lofty canopy, this Pokémon abides. On rare occasions, it shows up at the beach to match wits with Slowking."},{"games":["Sun"],"text":"Known for its extreme intelligence, this Pokémon will look down on inexperienced Trainers, so it’s best suited to veteran Trainers."}],"abilities":[{"name":"Inner Focus","hidden":false,"description":"The Pokémon's intense focus prevents it from flinching or being affected by Intimidate."},{"name":"Telepathy","hidden":false,"description":"The Pokémon anticipates and dodges the attacks of its allies."},{"name":"Symbiosis","hidden":true,"description":"The Pokémon passes its held item to an ally that has used up an item."}],"eggGroups":["Field"],"genderRate":4,"hatchCounter":20,"baseHappiness":70,"growthRate":"slow","habitat":null,"color":"White","shape":"Humanoid","evolution":{"id":765,"name":"Oranguru","condition":null,"children":[]},"moves":{"game":"Scarlet / Violet","level":[[1,93],[1,269],[5,495],[10,347],[15,500],[20,244],[25,511],[30,417],[35,428],[40,433],[45,94],[50,689],[55,492],[60,248]],"machine":[34,280,523,347,451,886,89,227,283,203,412,797,263,374,411,492,248,416,356,63,304,286,282,113,417,220,182,60,244,94,917,678,473,240,115,156,157,184,247,285,214,500,164,241,129,36,269,851,87,85,885,271,433,428],"egg":[138,326,387,281],"tutor":[]},"cards":[{"id":"s